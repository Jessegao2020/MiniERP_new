<Application
    x:Class="MiniERP.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- Default ERP table skin. Views that need an integrated filter row provide their own external header/filter, while every DataGrid shares the same thin SelectLine look. -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D4D4D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E4E4" />
            <Setter Property="VerticalGridLinesBrush" Value="#E4E4E4" />
            <Setter Property="RowBackground" Value="White" />
        </Style>
        <Style Selector="DataGrid DataGridColumnHeader">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="BorderBrush" Value="#C9C9C9" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="5,0,4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector="DataGrid DataGridColumnHeader:pointerover">
            <Setter Property="Background" Value="#F3F3F3" />
        </Style>
        <Style Selector="DataGrid DataGridCell">
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!-- DataGridTextColumn content is not clipped by default. Long text can render across the cell edge and visually cover the vertical grid line. -->
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="DataGrid DataGridCell TextBlock">
            <!-- Keep one-line ERP list cells inside their column and show explicitly when the value is truncated. -->
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="DataGrid DataGridRow.alternate">
            <Setter Property="Background" Value="#F3F3F3" />
        </Style>
        <Style Selector="DataGrid DataGridRow:pointerover">
            <Setter Property="Background" Value="#EAF2F8" />
        </Style>
        <Style Selector="DataGrid DataGridRow:selected">
            <Setter Property="Background" Value="#3394D6" />
            <Setter Property="TextBlock.Foreground" Value="#111111" />
        </Style>
    </Application.Styles>
</Application>
