<UserControl
    x:Class="MiniERP.Desktop.Views.Articles.ArticleListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">

    <UserControl.Styles>
        <Style Selector="Button.grid-header">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="5,0,4,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#F4F4F1" />
            <Setter Property="BorderBrush" Value="#C7C7C4" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Foreground" Value="#202020" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.grid-header:pointerover">
            <Setter Property="Background" Value="#E9EBEC" />
        </Style>

        <Style Selector="TextBox.grid-filter">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="5,0,4,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#FFF8D8" />
            <Setter Property="BorderBrush" Value="#D7D1B6" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3,0,0,0" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="New_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="＋" />
                    <TextBlock Text="New" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="⧉" />
                    <TextBlock Text="Duplicate" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="×" />
                    <TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Width="1" Margin="5,3" Background="#D0D0D0" />
            <Button Padding="8,2" Click="Refresh_Click" Content="Refresh" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,4,0,0" RowDefinitions="24,22,*">
            <!-- Classic ERP header: its only job is labeling and sorting. -->
            <Border Grid.Row="0" BorderBrush="#C7C7C4" BorderThickness="1,1,0,0">
                <Grid ColumnDefinitions="3*,*,*,2*,2*,2*,2*">
                    <Button Grid.Column="0" Classes="grid-header" Tag="Name" Click="Sort_Click">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Name" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="NameSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Classes="grid-header" Tag="Price" Click="Sort_Click">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Price" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="PriceSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="2" Classes="grid-header" Tag="MinimumPrice" Click="Sort_Click">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Min. Price" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="MinimumPriceSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="3" Classes="grid-header" Tag="Description" Click="Sort_Click">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Description" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="DescriptionSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="4" Classes="grid-header" Tag="Specification" Click="Sort_Click">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Specification" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SpecificationSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="5" Classes="grid-header" Tag="Discount" Click="Sort_Click">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Discount" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="DiscountSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="6" Classes="grid-header" Tag="Note" Click="Sort_Click">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Note" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="NoteSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <!-- Separate SelectLine-style search row: full-width cells, no Filter watermark. -->
            <Border Grid.Row="1" BorderBrush="#D7D1B6" BorderThickness="1,0,0,0">
                <Grid ColumnDefinitions="3*,*,*,2*,2*,2*,2*">
                    <TextBox Grid.Column="0" Classes="grid-filter" Tag="Name" TextChanged="Filter_TextChanged" />
                    <TextBox Grid.Column="1" Classes="grid-filter" Tag="Price" TextChanged="Filter_TextChanged" />
                    <TextBox Grid.Column="2" Classes="grid-filter" Tag="MinimumPrice" TextChanged="Filter_TextChanged" />
                    <TextBox Grid.Column="3" Classes="grid-filter" Tag="Description" TextChanged="Filter_TextChanged" />
                    <TextBox Grid.Column="4" Classes="grid-filter" Tag="Specification" TextChanged="Filter_TextChanged" />
                    <TextBox Grid.Column="5" Classes="grid-filter" Tag="Discount" TextChanged="Filter_TextChanged" />
                    <TextBox Grid.Column="6" Classes="grid-filter" Tag="Note" TextChanged="Filter_TextChanged" />
                </Grid>
            </Border>

            <dg:DataGrid
                x:Name="ArticleGrid"
                Grid.Row="2"
                AutoGenerateColumns="False"
                Background="White"
                BorderBrush="#C4C4C4"
                BorderThickness="1,0,1,1"
                CanUserResizeColumns="False"
                CanUserSortColumns="False"
                FontSize="12"
                GridLinesVisibility="All"
                HeadersVisibility="None"
                HorizontalGridLinesBrush="#DCDCDC"
                VerticalGridLinesBrush="#DCDCDC"
                RowBackground="White"
                RowHeight="24"
                IsReadOnly="True"
                SelectionMode="Single"
                LoadingRow="ArticleGrid_LoadingRow"
                ItemsSource="{Binding Articles}"
                SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                DoubleTapped="ArticleGrid_DoubleTapped">

                <dg:DataGrid.Styles>
                    <Style Selector="DataGridCell">
                        <Setter Property="Padding" Value="5,2" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style Selector="DataGridRow.alternate">
                        <Setter Property="Background" Value="#F3F3F3" />
                    </Style>
                    <Style Selector="DataGridRow:pointerover">
                        <Setter Property="Background" Value="#EAF2F8" />
                    </Style>
                    <Style Selector="DataGridRow:selected">
                        <Setter Property="Background" Value="#6AAFE0" />
                        <Setter Property="TextBlock.Foreground" Value="#111111" />
                    </Style>
                </dg:DataGrid.Styles>

                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Width="3*" Binding="{Binding Name}" />
                    <dg:DataGridTextColumn Width="*" Binding="{Binding Price}" />
                    <dg:DataGridTextColumn Width="*" Binding="{Binding MinimumPrice}" />
                    <dg:DataGridTextColumn Width="2*" Binding="{Binding Description}" />
                    <dg:DataGridTextColumn Width="2*" Binding="{Binding Specification}" />
                    <dg:DataGridTextColumn Width="2*" Binding="{Binding Discount}" />
                    <dg:DataGridTextColumn Width="2*" Binding="{Binding Note}" />
                </dg:DataGrid.Columns>
            </dg:DataGrid>
        </Grid>

        <Border Grid.Row="2" Padding="6,3" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Foreground="#CB004A" Text="{Binding Status}" />
                <TextBlock Grid.Column="1" Foreground="#CB004A" Text="Double-click a row to edit" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
