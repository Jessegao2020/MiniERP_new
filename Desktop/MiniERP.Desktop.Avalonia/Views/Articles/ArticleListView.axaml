<UserControl
    x:Class="MiniERP.Desktop.Views.Articles.ArticleListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">

    <UserControl.Styles>
        <Style Selector="Border.grid-header">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C9C9C9" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style Selector="Border.grid-header:pointerover">
            <Setter Property="Background" Value="#F3F3F3" />
        </Style>

        <Style Selector="TextBox.grid-filter">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="5,0,4,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#FFFEEF" />
            <Setter Property="BorderBrush" Value="#DDDCCB" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3,0,0,0" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="New_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="＋" />
                    <TextBlock Text="New" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="⧉" />
                    <TextBlock Text="Duplicate" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="×" />
                    <TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Width="1" Margin="5,3" Background="#D0D0D0" />
            <Button Padding="8,2" Click="Refresh_Click" Content="Refresh" />
        </StackPanel>

        <Grid x:Name="ArticleTableLayout"
              Grid.Row="1"
              Margin="0,4,0,0"
              RowDefinitions="24,22,*"
              SizeChanged="ArticleTableLayout_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="90" />
                <ColumnDefinition Width="*" MinWidth="65" />
                <ColumnDefinition Width="*" MinWidth="70" />
                <ColumnDefinition Width="2*" MinWidth="100" />
                <ColumnDefinition Width="2*" MinWidth="100" />
                <ColumnDefinition Width="2*" MinWidth="80" />
                <ColumnDefinition Width="2*" MinWidth="80" />
            </Grid.ColumnDefinitions>

            <!-- SelectLine-style title row: plain white cells, no Fluent button chrome. -->
            <Border Grid.Row="0" Grid.ColumnSpan="7" BorderBrush="#C9C9C9" BorderThickness="1,1,0,0" IsHitTestVisible="False" />

            <Border Grid.Row="0" Grid.Column="0" Classes="grid-header" Tag="Name" Tapped="SortHeader_Tapped">
                <Grid Margin="5,0,5,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Name" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock x:Name="NameSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Classes="grid-header" Tag="Price" Tapped="SortHeader_Tapped">
                <Grid Margin="5,0,5,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Price" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock x:Name="PriceSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="2" Classes="grid-header" Tag="MinimumPrice" Tapped="SortHeader_Tapped">
                <Grid Margin="5,0,5,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Min. Price" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock x:Name="MinimumPriceSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="3" Classes="grid-header" Tag="Description" Tapped="SortHeader_Tapped">
                <Grid Margin="5,0,5,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Description" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock x:Name="DescriptionSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="4" Classes="grid-header" Tag="Specification" Tapped="SortHeader_Tapped">
                <Grid Margin="5,0,5,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Specification" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock x:Name="SpecificationSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="5" Classes="grid-header" Tag="Discount" Tapped="SortHeader_Tapped">
                <Grid Margin="5,0,5,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Discount" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock x:Name="DiscountSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="6" Classes="grid-header" Tag="Note" Tapped="SortHeader_Tapped">
                <Grid Margin="5,0,5,0" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Note" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock x:Name="NoteSortArrow" Grid.Column="1" Margin="4,0,0,0" FontSize="8" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Separate very pale yellow search row, using the same live column definitions. -->
            <Border Grid.Row="1" Grid.ColumnSpan="7" BorderBrush="#DDDCCB" BorderThickness="1,0,0,0" IsHitTestVisible="False" />
            <TextBox Grid.Row="1" Grid.Column="0" Classes="grid-filter" Tag="Name" TextChanged="Filter_TextChanged" />
            <TextBox Grid.Row="1" Grid.Column="1" Classes="grid-filter" Tag="Price" TextChanged="Filter_TextChanged" />
            <TextBox Grid.Row="1" Grid.Column="2" Classes="grid-filter" Tag="MinimumPrice" TextChanged="Filter_TextChanged" />
            <TextBox Grid.Row="1" Grid.Column="3" Classes="grid-filter" Tag="Description" TextChanged="Filter_TextChanged" />
            <TextBox Grid.Row="1" Grid.Column="4" Classes="grid-filter" Tag="Specification" TextChanged="Filter_TextChanged" />
            <TextBox Grid.Row="1" Grid.Column="5" Classes="grid-filter" Tag="Discount" TextChanged="Filter_TextChanged" />
            <TextBox Grid.Row="1" Grid.Column="6" Classes="grid-filter" Tag="Note" TextChanged="Filter_TextChanged" />

            <!-- Transparent resize handles. Data columns are synchronized on every drag delta. -->
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" />
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" />
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" />
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" />
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" />
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" />

            <dg:DataGrid
                x:Name="ArticleGrid"
                Grid.Row="2"
                Grid.ColumnSpan="7"
                AutoGenerateColumns="False"
                Background="White"
                BorderBrush="#D4D4D4"
                BorderThickness="1,0,1,1"
                CanUserResizeColumns="False"
                CanUserSortColumns="False"
                FontSize="12"
                GridLinesVisibility="All"
                HeadersVisibility="None"
                HorizontalGridLinesBrush="#E4E4E4"
                VerticalGridLinesBrush="#E4E4E4"
                RowBackground="White"
                RowHeight="24"
                IsReadOnly="True"
                SelectionMode="Single"
                LoadingRow="ArticleGrid_LoadingRow"
                ItemsSource="{Binding Articles}"
                SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                DoubleTapped="ArticleGrid_DoubleTapped">

                <dg:DataGrid.Styles>
                    <Style Selector="DataGridCell">
                        <Setter Property="Padding" Value="5,2" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style Selector="DataGridRow.alternate">
                        <Setter Property="Background" Value="#F3F3F3" />
                    </Style>
                    <Style Selector="DataGridRow:pointerover">
                        <Setter Property="Background" Value="#EAF2F8" />
                    </Style>
                    <Style Selector="DataGridRow:selected">
                        <Setter Property="Background" Value="#3394D6" />
                        <Setter Property="TextBlock.Foreground" Value="#111111" />
                    </Style>
                </dg:DataGrid.Styles>

                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Width="3*" Binding="{Binding Name}" />
                    <dg:DataGridTextColumn Width="*" Binding="{Binding Price}" />
                    <dg:DataGridTextColumn Width="*" Binding="{Binding MinimumPrice}" />
                    <dg:DataGridTextColumn Width="2*" Binding="{Binding Description}" />
                    <dg:DataGridTextColumn Width="2*" Binding="{Binding Specification}" />
                    <dg:DataGridTextColumn Width="2*" Binding="{Binding Discount}" />
                    <dg:DataGridTextColumn Width="2*" Binding="{Binding Note}" />
                </dg:DataGrid.Columns>
            </dg:DataGrid>
        </Grid>

        <Border Grid.Row="2" Padding="6,3" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Foreground="#CB004A" Text="{Binding Status}" />
                <TextBlock Grid.Column="1" Foreground="#CB004A" Text="Double-click a row to edit" />
            </Grid>
        </Border>
    </Grid>
</UserControl>