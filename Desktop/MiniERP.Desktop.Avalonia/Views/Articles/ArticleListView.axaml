<UserControl
    x:Class="MiniERP.Desktop.Views.Articles.ArticleListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">

    <UserControl.Styles>
        <Style Selector="TextBox.grid-filter">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="5,0,4,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="#FBFBFB" />
            <Setter Property="BorderBrush" Value="#B7B7B7" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3,0,0,0" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="New_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="＋" />
                    <TextBlock Text="New" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="⧉" />
                    <TextBlock Text="Duplicate" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="×" />
                    <TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Width="1" Margin="5,3" Background="#D0D0D0" />
            <Button Padding="8,2" Click="Refresh_Click" Content="Refresh" />
        </StackPanel>

        <dg:DataGrid
            x:Name="ArticleGrid"
            Grid.Row="1"
            Margin="0,4,0,0"
            AutoGenerateColumns="False"
            Background="White"
            BorderBrush="#AFAFAF"
            BorderThickness="1"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            ColumnHeaderHeight="43"
            FontSize="12"
            GridLinesVisibility="All"
            HorizontalGridLinesBrush="#D0D0D0"
            VerticalGridLinesBrush="#D0D0D0"
            RowBackground="White"
            RowHeight="24"
            IsReadOnly="True"
            SelectionMode="Single"
            ItemsSource="{Binding Articles}"
            SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
            DoubleTapped="ArticleGrid_DoubleTapped">

            <dg:DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="#E9E9E9" />
                    <Setter Property="Foreground" Value="#202020" />
                    <Setter Property="BorderBrush" Value="#AFAFAF" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
                <Style Selector="DataGridCell">
                    <Setter Property="Padding" Value="5,2" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style Selector="DataGridRow:pointerover">
                    <Setter Property="Background" Value="#EEF5FA" />
                </Style>
                <Style Selector="DataGridRow:selected">
                    <Setter Property="Background" Value="#D7E8F5" />
                </Style>
            </dg:DataGrid.Styles>

            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Width="3*" Binding="{Binding Name}">
                    <dg:DataGridTextColumn.Header>
                        <Grid RowDefinitions="20,22">
                            <TextBlock Text="Name" Margin="5,0,4,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Classes="grid-filter" Tag="Name" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </Grid>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="*" Binding="{Binding Price}">
                    <dg:DataGridTextColumn.Header>
                        <Grid RowDefinitions="20,22">
                            <TextBlock Text="Price" Margin="5,0,4,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Classes="grid-filter" Tag="Price" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </Grid>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="*" Binding="{Binding MinimumPrice}">
                    <dg:DataGridTextColumn.Header>
                        <Grid RowDefinitions="20,22">
                            <TextBlock Text="Min. Price" Margin="5,0,4,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Classes="grid-filter" Tag="MinimumPrice" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </Grid>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="2*" Binding="{Binding Description}">
                    <dg:DataGridTextColumn.Header>
                        <Grid RowDefinitions="20,22">
                            <TextBlock Text="Description" Margin="5,0,4,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Classes="grid-filter" Tag="Description" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </Grid>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="2*" Binding="{Binding Specification}">
                    <dg:DataGridTextColumn.Header>
                        <Grid RowDefinitions="20,22">
                            <TextBlock Text="Specification" Margin="5,0,4,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Classes="grid-filter" Tag="Specification" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </Grid>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="2*" Binding="{Binding Discount}">
                    <dg:DataGridTextColumn.Header>
                        <Grid RowDefinitions="20,22">
                            <TextBlock Text="Discount" Margin="5,0,4,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Classes="grid-filter" Tag="Discount" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </Grid>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="2*" Binding="{Binding Note}">
                    <dg:DataGridTextColumn.Header>
                        <Grid RowDefinitions="20,22">
                            <TextBlock Text="Note" Margin="5,0,4,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Classes="grid-filter" Tag="Note" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </Grid>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>
            </dg:DataGrid.Columns>
        </dg:DataGrid>

        <Border Grid.Row="2" Padding="6,3" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Foreground="#CB004A" Text="{Binding Status}" />
                <TextBlock Grid.Column="1" Foreground="#CB004A" Text="Double-click a row to edit" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
