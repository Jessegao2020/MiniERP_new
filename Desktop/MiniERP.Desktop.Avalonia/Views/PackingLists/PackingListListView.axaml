<UserControl
    x:Class="MiniERP.Desktop.Views.PackingLists.PackingListListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:infra="clr-namespace:MiniERP.Desktop.Infrastructure"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">
    <UserControl.Styles>
        <Style Selector="Border.grid-header"><Setter Property="Background" Value="{DynamicResource ErpSurfaceBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="Border.grid-header:pointerover"><Setter Property="Background" Value="{DynamicResource ErpAlternateBrush}" /></Style>
        <Style Selector="TextBox.grid-filter"><Setter Property="Height" Value="22" /><Setter Property="MinHeight" Value="22" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="5,0,4,0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Background" Value="{DynamicResource ErpFilterBrush}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="11" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3,0,0,0" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="New_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="＋" />
                    <TextBlock Text="New" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="×" />
                    <TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border Width="1" Margin="5,3" Background="{DynamicResource ErpBorderBrush}" />
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="↻" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Packing List" />
        </StackPanel>
        <dg:DataGrid x:Name="PackingListGrid" Grid.Row="1" Margin="0,4,0,0" AutoGenerateColumns="False" Background="{DynamicResource ErpSurfaceBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1" CanUserResizeColumns="True" CanUserReorderColumns="False" CanUserSortColumns="True" Sorting="Grid_Sorting" FontSize="12" GridLinesVisibility="All" HeadersVisibility="Column" ColumnHeaderHeight="46" ColumnHeaderTheme="{StaticResource SelectLineFilterColumnHeader}" Classes="selectline-filter-grid" HorizontalGridLinesBrush="{DynamicResource ErpBorderBrush}" VerticalGridLinesBrush="Transparent" RowHeight="24" IsReadOnly="True" SelectionMode="Single" LoadingRow="Grid_LoadingRow" ItemsSource="{Binding PackingLists}" SelectedItem="{Binding SelectedPackingList, Mode=TwoWay}" DoubleTapped="PackingListGrid_DoubleTapped">
                <dg:DataGrid.Styles><Style Selector="DataGridCell"><Setter Property="Padding" Value="5,2" /></Style><Style Selector="DataGridRow.alternate"><Setter Property="Background" Value="{DynamicResource ErpAlternateBrush}" /></Style><Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="{DynamicResource ErpHoverBrush}" /></Style><Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource ErpSelectedBrush}" /><Setter Property="TextBlock.Foreground" Value="{DynamicResource ErpSelectionTextBrush}" /></Style></dg:DataGrid.Styles>
                <dg:DataGrid.Columns><dg:DataGridTextColumn Width="1.5*" Binding="{Binding PackingListNumber}" MinWidth="100">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="PackingListNumber"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="P/L No." FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Number" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="2*" Binding="{Binding CustomerNameSnapshot}" MinWidth="100">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="CustomerNameSnapshot"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Customer" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Customer" TextChanged="Filter_TextChanged" />
                                <Rectangle Grid.RowSpan="2" Classes="selectline-column-separator" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="1.2*" Binding="{Binding SalesContactNameSnapshot}" MinWidth="70">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="SalesContactNameSnapshot"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="User" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="User" TextChanged="Filter_TextChanged" />
                                <Rectangle Grid.RowSpan="2" Classes="selectline-column-separator" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="1.1*" Binding="{Binding PackingDate, StringFormat='{}{0:yyyy-MM-dd}'}" MinWidth="75">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="PackingDate"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Date" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Date" TextChanged="Filter_TextChanged" />
                                <Rectangle Grid.RowSpan="2" Classes="selectline-column-separator" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="1.2*" Binding="{Binding CustomerPoNumber}" MinWidth="80">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="CustomerPoNumber"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Customer PO" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="PO" TextChanged="Filter_TextChanged" />
                                <Rectangle Grid.RowSpan="2" Classes="selectline-column-separator" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="0.8*" Binding="{Binding TotalCartons}" MinWidth="60">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="TotalCartons"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Cartons" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="TotalCartons" TextChanged="Filter_TextChanged" />
                                <Rectangle Grid.RowSpan="2" Classes="selectline-column-separator" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="0.9*" Binding="{Binding TotalGrossWeight, StringFormat='{}{0:0.###}'}" MinWidth="65">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="TotalGrossWeight"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="G.W. kg" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="TotalGrossWeight" TextChanged="Filter_TextChanged" />
                                <Rectangle Grid.RowSpan="2" Classes="selectline-column-separator" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="0.9*" Binding="{Binding TotalCbm, StringFormat='{}{0:0.####}'}" MinWidth="60">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="TotalCbm"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="CBM" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="TotalCbm" TextChanged="Filter_TextChanged" />
                                <Rectangle Grid.RowSpan="2" Classes="selectline-column-separator" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="1.3*" Binding="{Binding SourceDocumentNumber}" MinWidth="80">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="SourceDocumentNumber"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Source" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Source" TextChanged="Filter_TextChanged" />
                                <Rectangle Grid.RowSpan="2" Classes="selectline-column-separator" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn></dg:DataGrid.Columns>
            </dg:DataGrid>
        <infra:SelectLineColumnRules Grid.Row="1" Margin="0,4,0,0"
                                     Target="{Binding #PackingListGrid}" LineBrush="{DynamicResource ErpBorderBrush}"
                                     IsHitTestVisible="False" ClipToBounds="True" />
        <Border Grid.Row="2" Padding="6,3" Height="26" ClipToBounds="True" Background="{DynamicResource ErpStatusBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1"><Grid ColumnDefinitions="*,Auto"><infra:StatusMessageTextBlock Text="{Binding Status}" Opacity="0" IsHitTestVisible="False" /><TextBlock Grid.Column="1" Foreground="{DynamicResource ErpFooterAccentBrush}" Text="Double-click a row to edit" /></Grid></Border>
    </Grid>
</UserControl>