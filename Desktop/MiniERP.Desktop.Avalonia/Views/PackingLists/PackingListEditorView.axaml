<UserControl
    x:Class="MiniERP.Desktop.Views.PackingLists.PackingListEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:infra="clr-namespace:MiniERP.Desktop.Infrastructure"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">

    <UserControl.Styles>
        <Style Selector="TabControl.document-sections TabItem">
            <Setter Property="Width" Value="150" /><Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" /><Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TabControl.document-sections TabItem:pointerover"><Setter Property="Background" Value="#F3F3F3" /></Style>
        <Style Selector="TabControl.document-sections TabItem:selected"><Setter Property="Background" Value="#E7E7E7" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="Border.document-section"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D2D2D2" /><Setter Property="BorderThickness" Value="1,0,0,0" /></Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.lookup-field">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#8A8A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.lookup-field AutoCompleteBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.lookup-field Button.lookup-button">
            <Setter Property="Width" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#B5B5B5" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.position-command">
            <Setter Property="Width" Value="64" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Save_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="✓" /><TextBlock Text="Save" FontSize="10" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Discard_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="↶" /><TextBlock Text="Discard" FontSize="10" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="×" /><TextBlock Text="Delete" FontSize="10" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="ExportPdf_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="↓" /><TextBlock Text="Export PDF" FontSize="10" /></StackPanel></Button>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,4,0,0" Padding="12,9" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,1,0,1"><ScrollViewer HorizontalScrollBarVisibility="Auto"><Grid ColumnDefinitions="140,300,140,300" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8" HorizontalAlignment="Left">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Packing List No." />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PackingList.PackingListNumber, Mode=TwoWay}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="User" />
                    <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Customer" />
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,34"><AutoCompleteBox Grid.Column="0" Margin="0,0,4,0" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" ValueMemberBinding="{Binding Name}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxDropDownHeight="260" Watermark="Type customer name" /><Button Grid.Column="1" Padding="0" Click="PickCustomer_Click" Content="..." /></Grid>
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Packing Date" />
                    <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding PackingDate, Mode=TwoWay}" />
</Grid></ScrollViewer></Border>
        <TabControl Grid.Row="2" Classes="document-sections" TabStripPlacement="Left" SelectedIndex="2">
<TabItem Header="General"><Border Classes="document-section"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,20" Spacing="14" MinWidth="800" HorizontalAlignment="Left"><TextBlock FontSize="17" FontWeight="SemiBold" Text="General" />
<Grid ColumnDefinitions="140,300,140,300" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Customer Contact" />
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,34"><AutoCompleteBox Grid.Column="0" Margin="0,0,4,0" ItemsSource="{Binding CustomerContacts}" SelectedItem="{Binding SelectedCustomerContact, Mode=TwoWay}" ValueMemberBinding="{Binding Name}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxDropDownHeight="220" Watermark="Type contact name" /><Button Grid.Column="1" Padding="0" Click="PickContact_Click" Content="..." /></Grid>
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Customer PO No." />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PackingList.CustomerPoNumber, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Customer PO Date" />
                    <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding CustomerPoDate, Mode=TwoWay}" />
</Grid>
<TextBlock Opacity="0.6" Text="{Binding SourceText}" TextWrapping="Wrap" />
</StackPanel></ScrollViewer></Border></TabItem>
<TabItem Header="Delivery / Text"><Border Classes="document-section"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,20" Spacing="14" MinWidth="800" HorizontalAlignment="Left"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Delivery / Text" />
<Grid ColumnDefinitions="140,300,140,300" RowDefinitions="Auto" ColumnSpacing="10" RowSpacing="10">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Delivery Term" />
                    <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" Width="280" MinWidth="280" MaxWidth="280" HorizontalAlignment="Left" ItemsSource="{Binding DeliveryTermOptions}" Text="{Binding PackingList.DeliveryTerm, Mode=TwoWay}" />
</Grid>
                <StackPanel Spacing="5"><TextBlock Text="Remarks" /><TextBox MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding PackingList.Remarks, Mode=TwoWay}" /></StackPanel>
</StackPanel></ScrollViewer></Border></TabItem>
<TabItem Header="Goods"><Border Classes="document-section"><Grid Margin="12,10" RowDefinitions="Auto,Auto,*,Auto">

<Border Grid.Row="0" Padding="8,7" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1">
  <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
    <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Selected Goods Position"/>
    <WrapPanel Grid.Row="1" Orientation="Horizontal">
      <StackPanel Width="500" Margin="0,0,10,4" Spacing="3">
        <TextBlock Classes="field-label" Text="Article" HorizontalAlignment="Left"/>
        <Border Classes="lookup-field">
          <Grid ColumnDefinitions="*,26">
            <AutoCompleteBox x:Name="GoodsArticleAutoComplete" Grid.Column="0" ItemsSource="{Binding Articles}"
                             SelectedItem="{Binding SelectedArticle, Mode=TwoWay}" ValueMemberBinding="{Binding Name}"
                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxDropDownHeight="260"
                             Watermark="Type article name" TextChanged="GoodsField_TextChanged">
              <AutoCompleteBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></AutoCompleteBox.ItemTemplate>
            </AutoCompleteBox>
            <Button Grid.Column="1" Classes="lookup-button" Click="PickGoodsArticle_Click" Content="..." />
          </Grid>
        </Border>
      </StackPanel>
      <StackPanel Width="82" Margin="0,0,10,4" Spacing="3">
        <TextBlock Classes="field-label" Text="Qty" HorizontalAlignment="Left"/>
        <NumericUpDown x:Name="GoodsQtyTextBox" Minimum="1" Increment="1" FormatString="0"
                       ClipValueToMinMax="True" AllowSpin="True" ShowButtonSpinner="True"
                       ValueChanged="GoodsQty_ValueChanged" />
      </StackPanel>
      <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
        <TextBlock Classes="field-label" Text="Unit" HorizontalAlignment="Left" />
        <TextBox x:Name="GoodsUnitTextBox" TextChanged="GoodsField_TextChanged" />
      </StackPanel>
    </WrapPanel>
    <StackPanel Grid.Row="2" Spacing="3">
      <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Description EN" />
      <TextBox x:Name="GoodsDescriptionTextBox" MinHeight="128" AcceptsReturn="True" TextWrapping="Wrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="GoodsField_TextChanged"/>
    </StackPanel>
  </Grid>
</Border>
<WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
<Button Classes="position-command" Click="NewGoods_Click" Content="New" />
<Button x:Name="GoodsSaveButton" Classes="position-command" Click="Save"+prefix+"_Click" Content="Save" IsEnabled="False" />
<Button Classes="position-command" Click="MoveGoodsUp_Click" Content="↑" />
<Button Classes="position-command" Click="MoveGoodsDown_Click" Content="↓" />
<Button Classes="position-command" Click="DeleteGoods_Click" Content="Delete" />
<Button Classes="position-command" Click="DiscardGoods_Click" Content="Discard" />
</WrapPanel>
<dg:DataGrid x:Name="GoodsGrid" Grid.Row="2" Margin="0,6,0,0" MinHeight="80"
             IsReadOnly="True" RowHeight="26" HeadersVisibility="All"
             AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
             GridLinesVisibility="All" LoadingRow="GoodsGrid_LoadingRow"
             DoubleTapped="GoodsGrid_DoubleTapped" ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
  <dg:DataGrid.Columns>
    <dg:DataGridTextColumn Width="2*" MinWidth="120" Header="Article" Binding="{Binding ArticleName}" />
    <dg:DataGridTextColumn Width="3*" MinWidth="180" Header="Description EN" Binding="{Binding Description}" />
    <dg:DataGridTextColumn Width="80" Header="Qty" Binding="{Binding QuantityText}" />
    <dg:DataGridTextColumn Width="80" Header="Unit" Binding="{Binding Unit}" />
  </dg:DataGrid.Columns>
</dg:DataGrid>
<Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
  <TextBlock Opacity="0.55" VerticalAlignment="Center" Text="Double-click a goods row to edit. Save applies changes to the document."/>
  <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding TotalQuantity, StringFormat='Total Qty: {0:0.####}'}"/>
</Grid>

</Grid></Border></TabItem>
<TabItem Header="Packages / Cartons"><Border Classes="document-section"><Grid Margin="12,10" RowDefinitions="Auto,Auto,*,Auto">

<Border Grid.Row="0" Padding="8,7" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1">
 <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
   <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Selected Package / Carton"/>
   <WrapPanel Grid.Row="1" Orientation="Horizontal">
     <StackPanel Width="170" Margin="0,0,10,4" Spacing="3">
       <TextBlock Classes="field-label" Text="Carton No./Range" HorizontalAlignment="Left"/>
       <TextBox x:Name="PackCartonTextBox" TextChanged="PackField_TextChanged"/>
     </StackPanel>
     <StackPanel Width="82" Margin="0,0,10,4" Spacing="3">
       <TextBlock Classes="field-label" Text="Count" HorizontalAlignment="Left"/>
       <NumericUpDown x:Name="PackCountTextBox" Minimum="1" Increment="1" FormatString="0"
                      ClipValueToMinMax="True" AllowSpin="True" ShowButtonSpinner="True"
                      ValueChanged="PackCount_ValueChanged"/>
     </StackPanel>
     <StackPanel Width="350" Margin="0,0,10,4" Spacing="3">
       <TextBlock Classes="field-label" Text="Contents" HorizontalAlignment="Left"/>
       <TextBox x:Name="PackContentsTextBox" TextChanged="PackField_TextChanged"/>
     </StackPanel>
   </WrapPanel>
   <WrapPanel Grid.Row="2" Orientation="Horizontal">
     <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
       <TextBlock Classes="field-label" Text="L cm" HorizontalAlignment="Left"/>
       <TextBox x:Name="PackLengthTextBox" TextChanged="PackField_TextChanged"/>
     </StackPanel>
     <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
       <TextBlock Classes="field-label" Text="W cm" HorizontalAlignment="Left"/>
       <TextBox x:Name="PackWidthTextBox" TextChanged="PackField_TextChanged"/>
     </StackPanel>
     <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
       <TextBlock Classes="field-label" Text="H cm" HorizontalAlignment="Left"/>
       <TextBox x:Name="PackHeightTextBox" TextChanged="PackField_TextChanged"/>
     </StackPanel>
     <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
       <TextBlock Classes="field-label" Text="N.W. kg" HorizontalAlignment="Left"/>
       <TextBox x:Name="PackNetTextBox" TextChanged="PackField_TextChanged"/>
     </StackPanel>
     <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
       <TextBlock Classes="field-label" Text="G.W. kg" HorizontalAlignment="Left"/>
       <TextBox x:Name="PackGrossTextBox" TextChanged="PackField_TextChanged"/>
     </StackPanel>
     <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
       <TextBlock Classes="field-label" Text="CBM/ctn" HorizontalAlignment="Left"/>
       <TextBox x:Name="PackCbmTextBox" IsReadOnly="True" IsTabStop="False"/>
     </StackPanel>
   </WrapPanel>
 </Grid>
</Border>
<WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
<Button Classes="position-command" Click="NewPack_Click" Content="New" />
<Button x:Name="PackSaveButton" Classes="position-command" Click="Save"+prefix+"_Click" Content="Save" IsEnabled="False" />
<Button Classes="position-command" Click="MovePackUp_Click" Content="↑" />
<Button Classes="position-command" Click="MovePackDown_Click" Content="↓" />
<Button Classes="position-command" Click="DeletePack_Click" Content="Delete" />
<Button Classes="position-command" Click="DiscardPack_Click" Content="Discard" />
</WrapPanel>
<dg:DataGrid x:Name="PackGrid" Grid.Row="2" Margin="0,6,0,0" MinHeight="80" IsReadOnly="True"
             RowHeight="26" HeadersVisibility="All" AutoGenerateColumns="False"
             CanUserResizeColumns="True" CanUserSortColumns="False" GridLinesVisibility="All"
             LoadingRow="PackGrid_LoadingRow" DoubleTapped="PackGrid_DoubleTapped"
             ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage, Mode=TwoWay}">
  <dg:DataGrid.Columns>
    <dg:DataGridTextColumn Width="110" Header="Carton No./Range" Binding="{Binding CartonNumber}" />
    <dg:DataGridTextColumn Width="65" Header="Count" Binding="{Binding PackageCountText}" />
    <dg:DataGridTextColumn Width="2*" MinWidth="150" Header="Contents" Binding="{Binding Contents}" />
    <dg:DataGridTextColumn Width="65" Header="L cm" Binding="{Binding LengthText}" />
    <dg:DataGridTextColumn Width="65" Header="W cm" Binding="{Binding WidthText}" />
    <dg:DataGridTextColumn Width="65" Header="H cm" Binding="{Binding HeightText}" />
    <dg:DataGridTextColumn Width="75" Header="N.W. kg" Binding="{Binding NetWeightText}" />
    <dg:DataGridTextColumn Width="75" Header="G.W. kg" Binding="{Binding GrossWeightText}" />
    <dg:DataGridTextColumn Width="75" Header="CBM/ctn" Binding="{Binding Cbm, StringFormat='{}{0:0.####}'}" />
  </dg:DataGrid.Columns>
</dg:DataGrid>
<Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
  <TextBlock Opacity="0.55" VerticalAlignment="Center" Text="Double-click a carton row to edit. Save applies changes to the document."/>
  <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding TotalsText}"/>
</Grid>

</Grid></Border></TabItem>
        </TabControl>
        <Border Grid.Row="3" Padding="6,3" Height="26" ClipToBounds="True" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1"><infra:StatusMessageTextBlock Text="{Binding Status}" Opacity="0" IsHitTestVisible="False" /></Border>
    </Grid>
</UserControl>
