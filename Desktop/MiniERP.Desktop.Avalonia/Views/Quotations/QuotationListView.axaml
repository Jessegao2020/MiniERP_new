<UserControl
    x:Class="MiniERP.Desktop.Views.Quotations.QuotationListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">
    <UserControl.Styles>
        <Style Selector="Border.grid-header"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#C9C9C9" /><Setter Property="BorderThickness" Value="0,0,1,1" /></Style>
        <Style Selector="Border.grid-header:pointerover"><Setter Property="Background" Value="#F3F3F3" /></Style>
        <Style Selector="TextBox.grid-filter"><Setter Property="Height" Value="22" /><Setter Property="MinHeight" Value="22" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="5,0,4,0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Background" Value="#FFFEEF" /><Setter Property="BorderBrush" Value="#DDDCCB" /><Setter Property="BorderThickness" Value="0,0,1,1" /><Setter Property="FontSize" Value="11" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3" Spacing="3"><Button Padding="8,2" Click="New_Click" Content="New" /><Button Padding="8,2" Click="Delete_Click" Content="Delete" /><Button Padding="8,2" Click="Refresh_Click" Content="Refresh" /></StackPanel>
        <Grid x:Name="QuotationTableLayout" Grid.Row="1" Margin="0,4,0,0" RowDefinitions="24,22,*" SizeChanged="TableLayout_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" MinWidth="105" /><ColumnDefinition Width="2*" MinWidth="100" /><ColumnDefinition Width="1.3*" MinWidth="75" /><ColumnDefinition Width="1.1*" MinWidth="75" /><ColumnDefinition Width="0.8*" MinWidth="55" /><ColumnDefinition Width="1.1*" MinWidth="70" /><ColumnDefinition Width="1.1*" MinWidth="75" /><ColumnDefinition Width="1.2*" MinWidth="75" /><ColumnDefinition Width="1.2*" MinWidth="75" /><ColumnDefinition Width="1.4*" MinWidth="85" />
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.ColumnSpan="10" BorderBrush="#C9C9C9" BorderThickness="1,1,0,0" IsHitTestVisible="False" />
            <Border Grid.Row="0" Grid.Column="0" Classes="grid-header" Tag="QuotationNumber" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Quotation No." FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="NumberSortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="0" Grid.Column="1" Classes="grid-header" Tag="Customer.Name" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Customer" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="CustomerSortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="0" Grid.Column="2" Classes="grid-header" Tag="User.Name" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="User" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="UserSortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="0" Grid.Column="3" Classes="grid-header" Tag="QuotationDate" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Date" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="DateSortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="0" Grid.Column="4" Classes="grid-header" Tag="Currency" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Currency" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="CurrencySortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="0" Grid.Column="5" Classes="grid-header" Tag="TotalAmount" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Total" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="TotalSortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="0" Grid.Column="6" Classes="grid-header" Tag="ValidUntil" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Valid Until" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="ValidSortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="0" Grid.Column="7" Classes="grid-header" Tag="DeliveryTerm" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Delivery Term" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="DeliverySortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="0" Grid.Column="8" Classes="grid-header" Tag="LeadTime" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Lead Time" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="LeadSortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="0" Grid.Column="9" Classes="grid-header" Tag="PaymentTerm" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Payment Term" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="PaymentSortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="1" Grid.ColumnSpan="10" Background="#FFFEEF" BorderBrush="#DDDCCB" BorderThickness="1,0,0,0" IsHitTestVisible="False" />
            <TextBox Grid.Row="1" Grid.Column="0" Classes="grid-filter" Tag="Number" TextChanged="Filter_TextChanged" /><TextBox Grid.Row="1" Grid.Column="1" Classes="grid-filter" Tag="Customer" TextChanged="Filter_TextChanged" /><TextBox Grid.Row="1" Grid.Column="2" Classes="grid-filter" Tag="User" TextChanged="Filter_TextChanged" /><TextBox Grid.Row="1" Grid.Column="3" Classes="grid-filter" Tag="Date" TextChanged="Filter_TextChanged" /><TextBox Grid.Row="1" Grid.Column="4" Classes="grid-filter" Tag="Currency" TextChanged="Filter_TextChanged" /><Border Grid.Row="1" Grid.Column="5" Background="#FFFEEF" BorderBrush="#DDDCCB" BorderThickness="0,0,1,1" /><TextBox Grid.Row="1" Grid.Column="6" Classes="grid-filter" Tag="ValidUntil" TextChanged="Filter_TextChanged" /><TextBox Grid.Row="1" Grid.Column="7" Classes="grid-filter" Tag="DeliveryTerm" TextChanged="Filter_TextChanged" /><TextBox Grid.Row="1" Grid.Column="8" Classes="grid-filter" Tag="LeadTime" TextChanged="Filter_TextChanged" /><TextBox Grid.Row="1" Grid.Column="9" Classes="grid-filter" Tag="PaymentTerm" TextChanged="Filter_TextChanged" />
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" /><GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" /><GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" /><GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" /><GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" /><GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="5" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" /><GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="6" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" /><GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="7" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" /><GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="8" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" />
            <dg:DataGrid x:Name="QuotationGrid" Grid.Row="2" Grid.ColumnSpan="10" AutoGenerateColumns="False" Background="White" BorderBrush="#D4D4D4" BorderThickness="1,0,1,1" CanUserResizeColumns="False" CanUserSortColumns="False" FontSize="12" GridLinesVisibility="All" HeadersVisibility="None" HorizontalGridLinesBrush="#E4E4E4" VerticalGridLinesBrush="#E4E4E4" RowHeight="24" IsReadOnly="True" SelectionMode="Single" LoadingRow="Grid_LoadingRow" ItemsSource="{Binding Quotations}" SelectedItem="{Binding SelectedQuotation, Mode=TwoWay}" DoubleTapped="QuotationGrid_DoubleTapped">
                <dg:DataGrid.Styles><Style Selector="DataGridCell"><Setter Property="Padding" Value="5,2" /></Style><Style Selector="DataGridRow.alternate"><Setter Property="Background" Value="#F3F3F3" /></Style><Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="#EAF2F8" /></Style><Style Selector="DataGridRow:selected"><Setter Property="Background" Value="#3394D6" /><Setter Property="TextBlock.Foreground" Value="#111111" /></Style></dg:DataGrid.Styles>
                <dg:DataGrid.Columns><dg:DataGridTextColumn Width="1.6*" Binding="{Binding QuotationNumber}" /><dg:DataGridTextColumn Width="2*" Binding="{Binding Customer.Name}" /><dg:DataGridTextColumn Width="1.3*" Binding="{Binding User.Name}" /><dg:DataGridTextColumn Width="1.1*" Binding="{Binding QuotationDate, StringFormat='{}{0:yyyy-MM-dd}'}" /><dg:DataGridTextColumn Width="0.8*" Binding="{Binding Currency}" /><dg:DataGridTextColumn Width="1.1*" Binding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" /><dg:DataGridTextColumn Width="1.1*" Binding="{Binding ValidUntil, StringFormat='{}{0:yyyy-MM-dd}'}" /><dg:DataGridTextColumn Width="1.2*" Binding="{Binding DeliveryTerm}" /><dg:DataGridTextColumn Width="1.2*" Binding="{Binding LeadTime}" /><dg:DataGridTextColumn Width="1.4*" Binding="{Binding PaymentTerm}" /></dg:DataGrid.Columns>
            </dg:DataGrid>
        </Grid>
        <Border Grid.Row="2" Padding="6,3" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1"><Grid ColumnDefinitions="*,Auto"><TextBlock Foreground="#CB004A" Text="{Binding Status}" /><TextBlock Grid.Column="1" Foreground="#CB004A" Text="Double-click a row to edit" /></Grid></Border>
    </Grid>
</UserControl>