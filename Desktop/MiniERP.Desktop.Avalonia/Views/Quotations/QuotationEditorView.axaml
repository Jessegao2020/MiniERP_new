<UserControl
    x:Class="MiniERP.Desktop.Views.Quotations.QuotationEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Save_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="✓" />
                    <TextBlock Text="Save" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Discard_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="↶" />
                    <TextBlock Text="Discard" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="×" />
                    <TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="24,18" Spacing="18" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Quotation Header" />

                <Grid ColumnDefinitions="140,280,140,280" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Quotation No." />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Quotation.QuotationNumber, Mode=TwoWay}" />

                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="User" />
                    <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Customer" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Quotation Date" />
                    <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding QuotationDate, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Delivery Term" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Quotation.DeliveryTerm, Mode=TwoWay}" />

                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="Valid Until" />
                    <DatePicker Grid.Row="2" Grid.Column="3" SelectedDate="{Binding ValidUntil, Mode=TwoWay}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Lead Time" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Quotation.LeadTime, Mode=TwoWay}" />

                    <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="Payment Term" />
                    <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Quotation.PaymentTerm, Mode=TwoWay}" />
                </Grid>

                <StackPanel Spacing="5">
                    <TextBlock Text="Remarks" />
                    <TextBox
                        MinHeight="100"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Text="{Binding Quotation.Remarks, Mode=TwoWay}" />
                </StackPanel>

                <Border Padding="18" BorderBrush="LightGray" BorderThickness="1" CornerRadius="2">
                    <StackPanel Spacing="5">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Quotation Items" />
                        <TextBlock
                            Opacity="0.6"
                            TextWrapping="Wrap"
                            Text="The original project only defined the quotation header; line items were never implemented. The item model and price snapshot will be added in the next quotation phase." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="6,3" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1">
            <TextBlock Foreground="#CB004A" Text="{Binding Status}" />
        </Border>
    </Grid>
</UserControl>
