<UserControl
    x:Class="MiniERP.Desktop.Views.Quotations.QuotationEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    xmlns:infra="clr-namespace:MiniERP.Desktop.Infrastructure">

    <UserControl.Resources>
        <infra:DateTimeOffsetDateConverter x:Key="DateValueConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TabControl.document-sections TabItem">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TabControl.document-sections TabItem:pointerover">
            <Setter Property="Background" Value="#F3F3F3" />
        </Style>
        <Style Selector="TabControl.document-sections TabItem:selected">
            <Setter Property="Background" Value="#E7E7E7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.section-surface">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D2D2D2" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- SelectLine-like lookup field: one outside border, with the picker button visually inside the input. -->
        <Style Selector="Border.lookup-field">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#8A8A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.lookup-field AutoCompleteBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.lookup-field Button.lookup-button">
            <Setter Property="Width" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#B5B5B5" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.position-command">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Save_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="✓" /><TextBlock Text="Save" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Discard_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="↶" /><TextBlock Text="Discard" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="×" /><TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="ExportPdf_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="↓" /><TextBlock Text="Export PDF" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Border Width="1" Margin="5,3" Background="LightGray" />
            <Button Padding="7,2" Background="Transparent" BorderThickness="0" Click="CreatePi_Click" Content="Create P/I" />
            <Button Padding="7,2" Background="Transparent" BorderThickness="0" Click="CreateInvoice_Click" Content="Create Invoice" />
            <Button Padding="7,2" Background="Transparent" BorderThickness="0" Click="CreatePackingList_Click" Content="Create P/L" />
            <Button Padding="7,2" Background="Transparent" BorderThickness="0" Click="CreateContract_Click" Content="Create Contract" />
        </WrapPanel>

        <Border Grid.Row="1" Margin="0,4,0,0" Padding="8,7" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,1,0,1">
            <WrapPanel Orientation="Horizontal">
                <Grid Width="355" Margin="0,2,12,2" ColumnDefinitions="92,*" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="field-label" Text="Quotation No." />
                    <TextBox Grid.Column="1" Text="{Binding Quotation.QuotationNumber, Mode=TwoWay}" />
                </Grid>

                <Grid Width="405" Margin="0,2,12,2" ColumnDefinitions="64,*" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="field-label" Text="Customer" />
                    <Border Grid.Column="1" Classes="lookup-field">
                        <Grid ColumnDefinitions="*,26">
                            <AutoCompleteBox x:Name="CustomerAutoComplete" Grid.Column="0" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" ValueMemberBinding="{Binding Name}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxDropDownHeight="260" Watermark="Type customer name">
                                <AutoCompleteBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8" MinWidth="250"><TextBlock Grid.Column="0" Text="{Binding Name}" /><TextBlock Grid.Column="1" Opacity="0.6" Text="{Binding City}" /><TextBlock Grid.Column="2" Opacity="0.6" Text="{Binding Country}" /></Grid></DataTemplate></AutoCompleteBox.ItemTemplate>
                            </AutoCompleteBox>
                            <Button Grid.Column="1" Classes="lookup-button" Click="PickCustomer_Click" Content="..." ToolTip.Tip="Open customer list" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Width="190" Margin="0,2,12,2" ColumnDefinitions="40,118" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="field-label" Text="Date" />
                    <CalendarDatePicker Grid.Column="1" Width="118" HorizontalAlignment="Left" SelectedDate="{Binding QuotationDate, Mode=TwoWay, Converter={StaticResource DateValueConverter}}" />
                </Grid>

                <Grid Width="220" Margin="0,2,12,2" ColumnDefinitions="42,*" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="field-label" Text="User" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </WrapPanel>
        </Border>

        <TabControl Grid.Row="2" Classes="document-sections" TabStripPlacement="Left" SelectedIndex="3">
            <TabItem Header="General">
                <Border Classes="section-surface">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,20" Spacing="14" MinWidth="540" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="General" />
                            <Grid ColumnDefinitions="150,360" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Customer Contact" />
                                <Border Grid.Row="0" Grid.Column="1" Classes="lookup-field">
                                    <Grid ColumnDefinitions="*,26">
                                        <AutoCompleteBox x:Name="ContactAutoComplete" Grid.Column="0" ItemsSource="{Binding CustomerContacts}" SelectedItem="{Binding SelectedCustomerContact, Mode=TwoWay}" ValueMemberBinding="{Binding Name}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxDropDownHeight="220" Watermark="Type contact name">
                                            <AutoCompleteBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Opacity="0.6" Text="{Binding Title}" /><TextBlock Text="{Binding Name}" /></StackPanel></DataTemplate></AutoCompleteBox.ItemTemplate>
                                        </AutoCompleteBox>
                                        <Button Grid.Column="1" Classes="lookup-button" Click="PickContact_Click" Content="..." ToolTip.Tip="Open contact list" />
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Valid Until" />
                                <CalendarDatePicker Grid.Row="1" Grid.Column="1" Width="118" HorizontalAlignment="Left" SelectedDate="{Binding ValidUntil, Mode=TwoWay, Converter={StaticResource DateValueConverter}}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Price / Terms">
                <Border Classes="section-surface">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <StackPanel Margin="22,20" Spacing="14" MinWidth="780" MaxWidth="850" HorizontalAlignment="Left">
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="Price / Terms" />
                            <Grid ColumnDefinitions="120,280,120,280" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="field-label" Text="Delivery Term" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Quotation.DeliveryTerm, Mode=TwoWay}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Classes="field-label" Text="Payment Term" />
                                <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding Quotation.PaymentTerm, Mode=TwoWay}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="field-label" Text="Lead Time" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Quotation.LeadTime, Mode=TwoWay}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Classes="field-label" Text="Currency" />
                                <ComboBox Grid.Row="1" Grid.Column="3" Width="130" HorizontalAlignment="Left" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency, Mode=TwoWay}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="field-label" Text="Rate Snapshot" />
                                <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" Text="{Binding ExchangeRateDisplay}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <TabItem Header="Text">
                <Border Classes="section-surface">
                    <Grid Margin="22,20" RowDefinitions="Auto,*" RowSpacing="10">
                        <TextBlock Grid.Row="0" FontSize="17" FontWeight="SemiBold" Text="Remarks" />
                        <TextBox Grid.Row="1" MinHeight="180" MaxWidth="950" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Quotation.Remarks, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Positions">
                <Border Classes="section-surface">
                    <Grid Margin="12,10" RowDefinitions="Auto,Auto,*,Auto">
                        <!-- One SelectLine-style editor handles both new and existing positions. -->
                        <Border x:Name="PositionEditorPanel" Grid.Row="0" Padding="8,7" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Selected Position" />

                                <!-- Field captions stay above their inputs so wrapping at narrow widths remains clean. -->
                                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                    <StackPanel Width="500" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Article" />
                                        <Border Classes="lookup-field">
                                            <Grid ColumnDefinitions="*,26">
                                                <AutoCompleteBox x:Name="ArticleAutoComplete"
                                                                 Grid.Column="0"
                                                                 ItemsSource="{Binding Articles}"
                                                                 SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                                                                 ValueMemberBinding="{Binding Name}"
                                                                 FilterMode="ContainsOrdinal"
                                                                 MinimumPrefixLength="0"
                                                                 MaxDropDownHeight="260"
                                                                 Watermark="Type article name"
                                                                 TextChanged="PositionEditor_TextChanged">
                                                    <AutoCompleteBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="2*,Auto" ColumnSpacing="12" MinWidth="280">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                                <TextBlock Grid.Column="1" Opacity="0.6" Text="{Binding Price, StringFormat='CNY {0:N2}'}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </AutoCompleteBox.ItemTemplate>
                                                </AutoCompleteBox>
                                                <Button Grid.Column="1" Classes="lookup-button" Click="PickArticle_Click" Content="..." ToolTip.Tip="Open article list" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Width="82" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Qty" />
                                        <TextBox x:Name="PositionQtyTextBox" TextChanged="PositionEditor_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Unit" />
                                        <TextBox x:Name="PositionUnitTextBox" TextChanged="PositionEditor_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Width="116" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Unit Price" />
                                        <TextBox x:Name="PositionUnitPriceTextBox" TextChanged="PositionEditor_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Disc. %" />
                                        <TextBox x:Name="PositionDiscountTextBox" TextChanged="PositionEditor_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Amount" />
                                        <TextBox x:Name="PositionAmountText" IsReadOnly="True" IsTabStop="False" />
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel Grid.Row="2" Spacing="3">
                                    <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Description EN" />
                                    <TextBox x:Name="PositionDescriptionTextBox" MinHeight="128" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="PositionEditor_TextChanged" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- SelectLine order: New, Save, move up, move down, delete, discard. -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Classes="position-command" Click="NewPosition_Click" Content="New" />
                            <Button x:Name="PositionSaveButton" Classes="position-command" IsEnabled="False" Click="SavePositionEdit_Click" Content="Save" ToolTip.Tip="Apply this position to the overview" />
                            <Button Classes="position-command" Click="MoveItemUp_Click" ToolTip.Tip="Move selected item up">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="↑" />
                            </Button>
                            <Button Classes="position-command" Click="MoveItemDown_Click" ToolTip.Tip="Move selected item down">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="↓" />
                            </Button>
                            <Button Classes="position-command" Click="DeletePosition_Click" Content="Delete" />
                            <Button Classes="position-command" Click="DiscardPosition_Click" Content="Discard" ToolTip.Tip="Discard the current position edit and clear the editor" />
                        </WrapPanel>

                        <!-- Explicit top margin is kept even when the window height is tight. -->
                        <dg:DataGrid x:Name="PositionsGrid"
                                     Grid.Row="2"
                                     Margin="0,6,0,0"
                                     MinHeight="80"
                                     AutoGenerateColumns="False"
                                     CanUserResizeColumns="True"
                                     CanUserSortColumns="False"
                                     GridLinesVisibility="All"
                                     IsReadOnly="True"
                                     RowHeight="26"
                                     LoadingRow="SelectLineGrid_LoadingRow"
                                     DoubleTapped="PositionsGrid_DoubleTapped"
                                     ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Width="2*" MinWidth="120" Header="Article" Binding="{Binding ArticleName}" />
                                <dg:DataGridTextColumn Width="3*" MinWidth="180" Header="Description EN" Binding="{Binding Description}" />
                                <dg:DataGridTextColumn Width="70" Header="Qty" Binding="{Binding QuantityText}" />
                                <dg:DataGridTextColumn Width="70" Header="Unit" Binding="{Binding Unit}" />
                                <dg:DataGridTextColumn Width="95" Header="Unit Price" Binding="{Binding UnitPriceText}" />
                                <dg:DataGridTextColumn Width="75" Header="Disc. %" Binding="{Binding DiscountText}" />
                                <dg:DataGridTextColumn Width="105" Header="Amount" Binding="{Binding LineTotal, StringFormat='{}{0:N2}'}" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>

                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                            <TextBlock Opacity="0.55" VerticalAlignment="Center" Text="New starts a blank position. Double-click a row to edit it. Save applies changes; Discard clears the editor." />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock FontSize="15" FontWeight="SemiBold" Text="Total" /><TextBlock FontSize="15" FontWeight="Bold" Text="{Binding TotalText}" /></StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Journal">
                <Border Classes="section-surface"><StackPanel Margin="22,20" Spacing="8"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Journal" /><TextBlock Opacity="0.6" Text="Document history and activity will appear here." /></StackPanel></Border>
            </TabItem>

            <TabItem Header="Extra Fields">
                <Border Classes="section-surface"><StackPanel Margin="22,20" Spacing="8"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Extra Fields" /><TextBlock Opacity="0.6" Text="Custom document fields can be added here later." /></StackPanel></Border>
            </TabItem>

            <TabItem Header="Archive">
                <Border Classes="section-surface"><StackPanel Margin="22,20" Spacing="8"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Archive" /><TextBlock Opacity="0.6" Text="Generated files and archived document versions can be shown here later." /></StackPanel></Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Padding="6,3" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1"><TextBlock Foreground="#CB004A" Text="{Binding Status}" /></Border>
    </Grid>
</UserControl>
