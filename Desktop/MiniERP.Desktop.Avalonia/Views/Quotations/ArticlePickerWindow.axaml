<Window
    x:Class="MiniERP.Desktop.Views.Quotations.ArticlePickerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    Title="Select Article" Width="1080" Height="650" MinWidth="820" MinHeight="440" WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Border.grid-header"><Setter Property="Background" Value="{DynamicResource ErpSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ErpBorderBrush}" /><Setter Property="BorderThickness" Value="0,0,1,1" /></Style>
        <Style Selector="Border.grid-header:pointerover"><Setter Property="Background" Value="{DynamicResource ErpAlternateBrush}" /></Style>
        <Style Selector="TextBox.grid-filter"><Setter Property="Height" Value="22" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="5,0,4,0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Background" Value="{DynamicResource ErpFilterBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ErpSpecialBrush}" /><Setter Property="BorderThickness" Value="0,0,1,1" /><Setter Property="FontSize" Value="11" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto,Auto">
        <dg:DataGrid x:Name="ArticleGrid" Grid.Row="0" Margin="8" AutoGenerateColumns="False" Background="{DynamicResource ErpSurfaceBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1" CanUserResizeColumns="True" CanUserReorderColumns="False" CanUserSortColumns="True" Sorting="Grid_Sorting" FontSize="12" GridLinesVisibility="All" HeadersVisibility="Column" ColumnHeaderHeight="46" ColumnHeaderTheme="{StaticResource SelectLineFilterColumnHeader}" Classes="selectline-filter-grid" HorizontalGridLinesBrush="{DynamicResource ErpGridBrush}" VerticalGridLinesBrush="{DynamicResource ErpGridBrush}" RowHeight="24" IsReadOnly="True" SelectionMode="Single" LoadingRow="Grid_LoadingRow" DoubleTapped="ArticleGrid_DoubleTapped">
                <dg:DataGrid.Styles><Style Selector="DataGridCell"><Setter Property="Padding" Value="5,2" /></Style><Style Selector="DataGridRow.alternate"><Setter Property="Background" Value="{DynamicResource ErpAlternateBrush}" /></Style><Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="{DynamicResource ErpHoverBrush}" /></Style><Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource ErpSelectedBrush}" /><Setter Property="TextBlock.Foreground" Value="{DynamicResource ErpSelectionTextBrush}" /></Style></dg:DataGrid.Styles>
                <dg:DataGrid.Columns><dg:DataGridTextColumn Width="2*" Binding="{Binding Name}" MinWidth="120">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="Name"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Name" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Name" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="2*" Binding="{Binding Name_EN}" MinWidth="120">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="Name_EN"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Name EN" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Name_EN" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="95" Binding="{Binding Price, StringFormat='{}{0:N2}'}" MinWidth="70">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="Price"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="CNY Price" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Price" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="2.5*" Binding="{Binding Description_EN}" MinWidth="150">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="Description_EN"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Description EN" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Description_EN" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="1.2*" Binding="{Binding Category}" MinWidth="80">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="Category"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Category" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Category" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn></dg:DataGrid.Columns>
            </dg:DataGrid>
        <Border Grid.Row="1" Padding="8,4" Background="{DynamicResource ErpAlternateBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1,1,1,0"><TextBlock x:Name="StatusText" Foreground="{DynamicResource ErpMutedBrush}" /></Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8" Spacing="8"><Button Width="90" IsDefault="True" Click="Ok_Click" Content="OK" /><Button Width="90" IsCancel="True" Click="Cancel_Click" Content="Cancel" /></StackPanel>
    </Grid>
</Window>