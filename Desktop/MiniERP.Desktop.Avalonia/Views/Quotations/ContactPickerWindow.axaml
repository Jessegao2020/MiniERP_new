<Window
    x:Class="MiniERP.Desktop.Views.Quotations.ContactPickerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    Title="Select Contact"
    Width="620"
    Height="480"
    MinWidth="480"
    MinHeight="340"
    WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto,Auto">
        <dg:DataGrid
            x:Name="ContactGrid"
            Grid.Row="0"
            Margin="8"
            AutoGenerateColumns="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            GridLinesVisibility="All"
            IsReadOnly="True"
            DoubleTapped="ContactGrid_DoubleTapped">

            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Width="1.1*" Binding="{Binding Title}">
                    <dg:DataGridTextColumn.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Title" />
                            <TextBox MinWidth="90" Height="24" Tag="Title" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </StackPanel>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="2.5*" Binding="{Binding Name}">
                    <dg:DataGridTextColumn.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Name" />
                            <TextBox MinWidth="180" Height="24" Tag="Name" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </StackPanel>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>
            </dg:DataGrid.Columns>
        </dg:DataGrid>

        <Border Grid.Row="1" Padding="8,4" Background="#F2F2F2" BorderBrush="LightGray" BorderThickness="1,1,1,0">
            <TextBlock x:Name="StatusText" Foreground="#666666" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8" Spacing="8">
            <Button Width="90" IsDefault="True" Click="Ok_Click" Content="OK" />
            <Button Width="90" IsCancel="True" Click="Cancel_Click" Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
