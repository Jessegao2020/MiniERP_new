<UserControl
    x:Class="MiniERP.Desktop.Views.Settings.SystemSettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Save_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="✓" />
                    <TextBlock Text="Save" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="18,16" Spacing="12" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="System Settings" />

            <Border Padding="16" BorderThickness="1" CornerRadius="4">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Exchange Rate" />
                    <TextBlock Opacity="0.65" Text="This rate is used to calculate the USD reference price shown on Article pages." TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="1 USD =" />
                        <TextBox
                            x:Name="ExchangeRateTextBox"
                            Width="150"
                            Text="{Binding ExchangeRateText, Mode=TwoWay}" />
                        <TextBlock VerticalAlignment="Center" Text="CNY" />
                    </StackPanel>

                    <TextBlock Opacity="0.65" Text="{Binding PreviewText}" />
                </StackPanel>
            </Border>

            <TextBlock Opacity="0.55" Text="The Article master data keeps its CNY base price. USD is calculated from this setting and is not stored as a second article price." TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2" Padding="6,3" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1">
            <TextBlock Foreground="#CB004A" Text="{Binding Status}" />
        </Border>
    </Grid>
</UserControl>
