<UserControl
    x:Class="MiniERP.Desktop.Views.Invoices.InvoiceListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3" Spacing="3">
            <Button Padding="8,2" Click="New_Click" Content="New" />
            <Button Padding="8,2" Click="Delete_Click" Content="Delete" />
            <Button Padding="8,2" Click="Refresh_Click" Content="Refresh" />
            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DocumentTitle}" />
        </StackPanel>
        <dg:DataGrid x:Name="InvoiceGrid" Grid.Row="1" Margin="0,5,0,0" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="All" IsReadOnly="True" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}" DoubleTapped="InvoiceGrid_DoubleTapped">
            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Width="1.5*" Binding="{Binding InvoiceNumber}">
                    <dg:DataGridTextColumn.Header><StackPanel Spacing="2"><TextBlock Text="Document No." /><TextBox MinWidth="100" Height="24" Tag="Number" Watermark="Filter" TextChanged="Filter_TextChanged" /></StackPanel></dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>
                <dg:DataGridTextColumn Width="2*" Binding="{Binding CustomerNameSnapshot}">
                    <dg:DataGridTextColumn.Header><StackPanel Spacing="2"><TextBlock Text="Customer" /><TextBox MinWidth="100" Height="24" Tag="Customer" Watermark="Filter" TextChanged="Filter_TextChanged" /></StackPanel></dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>
                <dg:DataGridTextColumn Width="1.2*" Binding="{Binding SalesContactNameSnapshot}">
                    <dg:DataGridTextColumn.Header><StackPanel Spacing="2"><TextBlock Text="User" /><TextBox MinWidth="70" Height="24" Tag="User" Watermark="Filter" TextChanged="Filter_TextChanged" /></StackPanel></dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>
                <dg:DataGridTextColumn Width="1.1*" Binding="{Binding InvoiceDate, StringFormat='{}{0:yyyy-MM-dd}'}">
                    <dg:DataGridTextColumn.Header><StackPanel Spacing="2"><TextBlock Text="Date" /><TextBox MinWidth="75" Height="24" Tag="Date" Watermark="Filter" TextChanged="Filter_TextChanged" /></StackPanel></dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>
                <dg:DataGridTextColumn Width="1.2*" Binding="{Binding CustomerPoNumber}">
                    <dg:DataGridTextColumn.Header><StackPanel Spacing="2"><TextBlock Text="Customer PO" /><TextBox MinWidth="80" Height="24" Tag="PO" Watermark="Filter" TextChanged="Filter_TextChanged" /></StackPanel></dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>
                <dg:DataGridTextColumn Width="0.8*" Binding="{Binding Currency}">
                    <dg:DataGridTextColumn.Header><StackPanel Spacing="2"><TextBlock Text="Currency" /><TextBox MinWidth="55" Height="24" Tag="Currency" Watermark="Filter" TextChanged="Filter_TextChanged" /></StackPanel></dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>
                <dg:DataGridTextColumn Width="1.1*" Header="Total" Binding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" />
                <dg:DataGridTextColumn Width="1.3*" Binding="{Binding SourceDocumentNumber}">
                    <dg:DataGridTextColumn.Header><StackPanel Spacing="2"><TextBlock Text="Source" /><TextBox MinWidth="80" Height="24" Tag="Source" Watermark="Filter" TextChanged="Filter_TextChanged" /></StackPanel></dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>
            </dg:DataGrid.Columns>
        </dg:DataGrid>
        <Border Grid.Row="2" Padding="6,3" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1"><Grid ColumnDefinitions="*,Auto"><TextBlock Foreground="#CB004A" Text="{Binding Status}" /><TextBlock Grid.Column="1" Foreground="#CB004A" Text="Double-click a row to edit" /></Grid></Border>
    </Grid>
</UserControl>
