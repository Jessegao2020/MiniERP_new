<UserControl
    x:Class="MiniERP.Desktop.Views.Contracts.ContractEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:infra="clr-namespace:MiniERP.Desktop.Infrastructure"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">

    <UserControl.Styles>
        <Style Selector="TabControl.document-sections TabItem">
            <Setter Property="Width" Value="150" /><Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="12,0" /><Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TabControl.document-sections TabItem:pointerover"><Setter Property="Background" Value="#F3F3F3" /></Style>
        <Style Selector="TabControl.document-sections TabItem:selected"><Setter Property="Background" Value="#E7E7E7" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="Border.document-section"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D2D2D2" /><Setter Property="BorderThickness" Value="1,0,0,0" /></Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.lookup-field">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#8A8A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.lookup-field AutoCompleteBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Border.lookup-field Button.lookup-button">
            <Setter Property="Width" Value="26" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#EEEEEE" />
            <Setter Property="BorderBrush" Value="#B5B5B5" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.position-command">
            <Setter Property="Width" Value="64" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Save_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="✓" /><TextBlock Text="Save" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Discard_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="↶" /><TextBlock Text="Discard" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="×" /><TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="ExportPdf_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="↓" /><TextBlock Text="Export PDF" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="ExportXlsx_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="▦" /><TextBlock Text="Export XLSX" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Border Width="1" Margin="5,3" Background="LightGray" />
            <Button Padding="7,2" Background="Transparent" BorderThickness="0" Click="CreateProforma_Click" Content="Create P/I" />
            <Button Padding="7,2" Background="Transparent" BorderThickness="0" Click="CreateInvoice_Click" Content="Create Invoice" />
            <Button Padding="7,2" Background="Transparent" BorderThickness="0" Click="CreatePackingList_Click" Content="Create Packing List" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,4,0,0" Padding="12,9" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,1,0,1"><ScrollViewer HorizontalScrollBarVisibility="Auto"><Grid ColumnDefinitions="140,300,140,300" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8" HorizontalAlignment="Left">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Contract No." />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Contract.ContractNumber, Mode=TwoWay}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Text="User" />
                    <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Customer" />
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,34">
                        <AutoCompleteBox Grid.Column="0" Margin="0,0,4,0" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" ValueMemberBinding="{Binding Name}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxDropDownHeight="260" Watermark="Type customer name" />
                        <Button Grid.Column="1" Padding="0" Click="PickCustomer_Click" Content="..." ToolTip.Tip="Open customer list" />
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Contract Date" />
                    <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding ContractDate, Mode=TwoWay}" />
</Grid></ScrollViewer></Border>
        <TabControl Grid.Row="2" Classes="document-sections" TabStripPlacement="Left" SelectedIndex="3">
<TabItem Header="General"><Border Classes="document-section"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,20" Spacing="14" MinWidth="800" HorizontalAlignment="Left"><TextBlock FontSize="17" FontWeight="SemiBold" Text="General" />
<Grid ColumnDefinitions="140,300,140,300" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Customer Contact" />
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,34">
                        <AutoCompleteBox Grid.Column="0" Margin="0,0,4,0" ItemsSource="{Binding CustomerContacts}" SelectedItem="{Binding SelectedCustomerContact, Mode=TwoWay}" ValueMemberBinding="{Binding Name}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxDropDownHeight="220" Watermark="Type contact name" />
                        <Button Grid.Column="1" Padding="0" Click="PickContact_Click" Content="..." />
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Customer PO No." />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Contract.CustomerPoNumber, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Customer PO Date" />
                    <DatePicker Grid.Row="1" Grid.Column="3" SelectedDate="{Binding CustomerPoDate, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Source" />
                    <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True" Text="{Binding SourceText}" />
</Grid>
</StackPanel></ScrollViewer></Border></TabItem>
<TabItem Header="Price / Terms"><Border Classes="document-section"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,20" Spacing="14" MinWidth="800" HorizontalAlignment="Left"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Price / Terms" />
<Grid ColumnDefinitions="140,300,140,300" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Lead Time" />
                    <ComboBox Grid.Row="0" Grid.Column="1" IsEditable="True" Width="280" MinWidth="280" MaxWidth="280" HorizontalAlignment="Left" ItemsSource="{Binding LeadTimeOptions}" Text="{Binding Contract.LeadTime, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Delivery Term" />
                    <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" Width="280" MinWidth="280" MaxWidth="280" HorizontalAlignment="Left" ItemsSource="{Binding DeliveryTermOptions}" Text="{Binding Contract.DeliveryTerm, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Payment Term" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Contract.PaymentTerm, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Currency" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" ItemsSource="{Binding Currencies}" SelectedItem="{Binding Currency, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="Rate Snapshot" />
                    <TextBox Grid.Row="2" Grid.Column="3" IsReadOnly="True" Text="{Binding ExchangeRateDisplay}" />
</Grid>
</StackPanel></ScrollViewer></Border></TabItem>
<TabItem Header="Text / Clauses"><Border Classes="document-section"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel Margin="22,20" Spacing="14" MinWidth="800" HorizontalAlignment="Left"><TextBlock FontSize="17" FontWeight="SemiBold" Text="Text / Clauses" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="5"><TextBlock Text="Bank Information" /><TextBox MinHeight="86" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Contract.BankInformation, Mode=TwoWay}" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Remarks" /><TextBox MinHeight="86" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Contract.Remarks, Mode=TwoWay}" /></StackPanel>
                </Grid>
                <StackPanel Spacing="5">
                    <TextBlock Text="Terms and Conditions" />
                    <TextBox MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap" Watermark="Optional contract clauses / special terms" Text="{Binding Contract.TermsAndConditions, Mode=TwoWay}" />
                </StackPanel>
</StackPanel></ScrollViewer></Border></TabItem>
            <TabItem Header="Positions">
                <Border Classes="document-section">
                    <!-- No outer horizontal ScrollViewer: clicking rows must not shift the whole page. -->
                    <Grid Margin="12,10" RowDefinitions="Auto,Auto,*,Auto">
                        <Border x:Name="PositionEditorPanel" Grid.Row="0" Padding="8,7"
                                Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Selected Position" />
                                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                    <StackPanel Width="500" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Article" />
                                        <Border Classes="lookup-field">
                                            <Grid ColumnDefinitions="*,26">
                                                <AutoCompleteBox x:Name="ArticleAutoComplete" Grid.Column="0"
                                                                 ItemsSource="{Binding Articles}"
                                                                 SelectedItem="{Binding SelectedArticle, Mode=TwoWay}"
                                                                 ValueMemberBinding="{Binding Name}"
                                                                 FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                                                 MaxDropDownHeight="260" Watermark="Type article name"
                                                                 TextChanged="PositionEditor_TextChanged">
                                                    <AutoCompleteBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="2*,Auto" ColumnSpacing="12" MinWidth="280">
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                                                <TextBlock Grid.Column="1" Opacity="0.6" Text="{Binding Price, StringFormat='CNY {0:N2}'}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </AutoCompleteBox.ItemTemplate>
                                                </AutoCompleteBox>
                                                <Button Grid.Column="1" Classes="lookup-button" Click="PickPositionArticle_Click"
                                                        Content="..." ToolTip.Tip="Open article list" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Width="82" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Qty" />
                                        <NumericUpDown x:Name="PositionQtyTextBox"
                                                       Minimum="1" Increment="1" FormatString="0"
                                                       ClipValueToMinMax="True" AllowSpin="True"
                                                       ShowButtonSpinner="True"
                                                       ValueChanged="PositionQty_ValueChanged" />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Unit" />
                                        <TextBox x:Name="PositionUnitTextBox" TextChanged="PositionEditor_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Width="116" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Unit Price" />
                                        <TextBox x:Name="PositionUnitPriceTextBox" TextChanged="PositionEditor_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Width="100" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Disc. %" />
                                        <TextBox x:Name="PositionDiscountTextBox" TextChanged="PositionEditor_TextChanged" />
                                    </StackPanel>
                                    <StackPanel Width="110" Margin="0,0,10,4" Spacing="3">
                                        <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Amount" />
                                        <TextBox x:Name="PositionAmountText" IsReadOnly="True" IsTabStop="False" />
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel Grid.Row="2" Spacing="3">
                                    <TextBlock Classes="field-label" HorizontalAlignment="Left" Text="Description EN" />
                                    <TextBox x:Name="PositionDescriptionTextBox" MinHeight="128" AcceptsReturn="True"
                                             TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             TextChanged="PositionEditor_TextChanged" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Classes="position-command" Click="NewPosition_Click" Content="New" />
                            <Button x:Name="PositionSaveButton" Classes="position-command" IsEnabled="False"
                                    Click="SavePositionEdit_Click" Content="Save" ToolTip.Tip="Apply this position to the overview" />
                            <Button Classes="position-command" Click="MoveItemUp_Click" Content="↑" />
                            <Button Classes="position-command" Click="MoveItemDown_Click" Content="↓" />
                            <Button Classes="position-command" Click="DeletePosition_Click" Content="Delete" />
                            <Button Classes="position-command" Click="DiscardPosition_Click" Content="Discard" />
                        </WrapPanel>
                        <dg:DataGrid x:Name="PositionsGrid" Grid.Row="2" Margin="0,6,0,0"
                                     MinHeight="80" AutoGenerateColumns="False"
                                     CanUserResizeColumns="True" CanUserSortColumns="False"
                                     HeadersVisibility="All" RowHeight="26"
                                     IsReadOnly="True" GridLinesVisibility="All"
                                     LoadingRow="PositionsGrid_LoadingRow"
                                     DoubleTapped="PositionsGrid_DoubleTapped"
                                     ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                            <dg:DataGrid.Columns>
                                <dg:DataGridTextColumn Width="2*" MinWidth="120" Header="Article" Binding="{Binding ArticleName}" />
                                <dg:DataGridTextColumn Width="3*" MinWidth="180" Header="Description EN" Binding="{Binding Description}" />
                                <dg:DataGridTextColumn Width="70" Header="Qty" Binding="{Binding QuantityText}" />
                                <dg:DataGridTextColumn Width="70" Header="Unit" Binding="{Binding Unit}" />
                                <dg:DataGridTextColumn Width="95" Header="Unit Price" Binding="{Binding UnitPriceText}" />
                                <dg:DataGridTextColumn Width="75" Header="Disc. %" Binding="{Binding DiscountText}" />
                                <dg:DataGridTextColumn Width="105" Header="Amount" Binding="{Binding LineTotal, StringFormat='{}{0:N2}'}" />
                            </dg:DataGrid.Columns>
                        </dg:DataGrid>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                            <TextBlock Opacity="0.55" VerticalAlignment="Center"
                                       Text="New starts a blank position. Double-click a row to edit. Position Save applies changes." />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="Total" />
                                <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding TotalText}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Padding="6,3" Height="26" ClipToBounds="True" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1"><infra:StatusMessageTextBlock Text="{Binding Status}" Opacity="0" IsHitTestVisible="False" /></Border>
    </Grid>
</UserControl>
