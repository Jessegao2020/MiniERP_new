<UserControl
    x:Class="MiniERP.Desktop.Views.Customers.CustomerEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:infra="clr-namespace:MiniERP.Desktop.Infrastructure"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    Background="{DynamicResource ErpPageBrush}">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="180,*">
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Background="{DynamicResource ErpSurfaceBrush}" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Save_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="✓" /><TextBlock Text="Save" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Discard_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="↶" /><TextBlock Text="Discard" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="×" /><TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Margin="5" Background="{DynamicResource ErpSurfaceBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="2" Spacing="0">
                    <StackPanel.Styles>
                        <Style Selector="Button.customer-nav-item">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Height" Value="24" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="20,0,4,0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="CornerRadius" Value="0" />
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <ContentPresenter x:Name="PART_ContentPresenter"
                                                      Background="{TemplateBinding Background}"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Padding="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="Button.customer-nav-item.child">
                            <Setter Property="Padding" Value="36,0,4,0" />
                        </Style>
                        <Style Selector="Button.customer-nav-item.group">
                            <Setter Property="Padding" Value="4,0,4,0" />
                        </Style>
                        <Style Selector="Button.customer-nav-item:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ErpHoverBrush}" />
                        </Style>
                        <Style Selector="Button.customer-nav-item.active">
                            <Setter Property="Background" Value="{DynamicResource ErpSelectedSectionBrush}" />
                        </Style>
                    </StackPanel.Styles>

                    <Button x:Name="AddressNav" Classes="customer-nav-item" Click="Address_Click" Content="Address" />
                    <Button x:Name="ContactNav" Classes="customer-nav-item" Click="Contact_Click" Content="Contact" />
                    <Button Classes="customer-nav-item group" Click="ToggleHistory_Click">
                        <Grid ColumnDefinitions="16,*">
                            <TextBlock x:Name="HistoryChevron" Grid.Column="0" Text="⌄" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="History" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <StackPanel x:Name="HistoryNavItems" IsVisible="True" Spacing="0">
                        <Button x:Name="QuoteNav" Classes="customer-nav-item child" Click="QuoteHistory_Click" Content="Quotation" />
                        <Button x:Name="ProformaNav" Classes="customer-nav-item child" Click="ProformaHistory_Click" Content="P/I" />
                        <Button x:Name="ContractNav" Classes="customer-nav-item child" Click="ContractHistory_Click" Content="Contract" />
                        <Button x:Name="InvoiceNav" Classes="customer-nav-item child" Click="InvoiceHistory_Click" Content="Invoice" />
                        <Button x:Name="PackingListNav" Classes="customer-nav-item child" Click="PackingListHistory_Click" Content="P/L" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,5,5,5" Background="{DynamicResource ErpSurfaceBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer x:Name="AddressPanel" IsVisible="True">
                    <Grid Margin="30,20,30,20" HorizontalAlignment="Left" ColumnDefinitions="Auto,280" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <CheckBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Right" Content="Active" IsChecked="{Binding Customer.IsActive, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Name" /><TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Customer.Name, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Address Line 1" /><TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding Customer.AddressLine1, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Address Line 2" /><TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding Customer.AddressLine2, Mode=TwoWay}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Country / ZIP / City" />
                        <Grid Grid.Row="4" Grid.Column="1" Margin="0,2" ColumnDefinitions="64,72,*" ColumnSpacing="4">
                            <Border Grid.Column="0" Background="{DynamicResource ErpSurfaceBrush}"
                                    BorderBrush="{DynamicResource ErpFrameBrush}" BorderThickness="1"
                                    CornerRadius="3" ClipToBounds="True">
                                <Grid ColumnDefinitions="*,24">
                                    <TextBox Grid.Column="0" MinWidth="0" Padding="4,0"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center" IsReadOnly="True"
                                             Text="{Binding CountryCode, Mode=OneWay}" ToolTip.Tip="Country code" />
                                    <Button Grid.Column="1" MinWidth="0" MinHeight="0" Padding="0"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Background="{DynamicResource ErpLookupBrush}"
                                            BorderBrush="{DynamicResource ErpFrameBrush}" BorderThickness="1,0,0,0"
                                            CornerRadius="0" Click="PickCountry_Click" Content="..."
                                            ToolTip.Tip="Select country" />
                                </Grid>
                            </Border>
                            <TextBox Grid.Column="1" MinWidth="0" Padding="5,0" VerticalContentAlignment="Center"
                                     Text="{Binding Customer.PostalCode, Mode=TwoWay}" Watermark="ZIP" ToolTip.Tip="Postal code" />
                            <TextBox Grid.Column="2" MinWidth="0" Padding="5,0" VerticalContentAlignment="Center"
                                     Text="{Binding Customer.City, Mode=TwoWay}" Watermark="City" ToolTip.Tip="City" />
                        </Grid>
                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="State" /><TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" Text="{Binding Customer.State, Mode=TwoWay}" />
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="ContactPanel" IsVisible="False" RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3" Spacing="3">
                        <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="NewContact_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="＋" /><TextBlock Text="New" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="DeleteContact_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="×" /><TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
                    </StackPanel>

                    <dg:DataGrid Grid.Row="1" Margin="5" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="All" RowHeight="24" LoadingRow="SelectLineGrid_LoadingRow" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact, Mode=TwoWay}">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Width="2*" Binding="{Binding Title, Mode=TwoWay}" Header="Title" />
                            <dg:DataGridTextColumn Width="4*" Binding="{Binding Name, Mode=TwoWay}" Header="Name" />
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>

                    <TextBlock Grid.Row="2" Margin="8,4" Opacity="0.6" Text="Contacts are saved together with the customer. Double-click a cell to edit it." />
                </Grid>

                <Grid x:Name="DocumentHistoryPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="6">
                    <TextBlock x:Name="DocumentHistoryTitle" Grid.Row="0" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="DocumentHistoryStatus" Grid.Row="1" Opacity="0.7" TextWrapping="Wrap" />
                    <dg:DataGrid x:Name="DocumentHistoryGrid" Grid.Row="2" AutoGenerateColumns="False"
                                 IsReadOnly="True" SelectionMode="Single" CanUserResizeColumns="True"
                                 CanUserSortColumns="True" GridLinesVisibility="All" RowHeight="24"
                                 Background="{DynamicResource ErpSurfaceBrush}"
                                 HorizontalGridLinesBrush="{DynamicResource ErpGridBrush}"
                                 VerticalGridLinesBrush="{DynamicResource ErpGridBrush}"
                                 LoadingRow="SelectLineGrid_LoadingRow" DoubleTapped="DocumentHistoryGrid_DoubleTapped">
                        <dg:DataGrid.Styles>
                            <Style Selector="DataGridRow.alternate"><Setter Property="Background" Value="{DynamicResource ErpAlternateBrush}" /></Style>
                            <Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="{DynamicResource ErpHoverBrush}" /></Style>
                            <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource ErpSelectedBrush}" /><Setter Property="TextBlock.Foreground" Value="{DynamicResource ErpSelectionTextBrush}" /></Style>
                        </dg:DataGrid.Styles>
                    </dg:DataGrid>
                </Grid>

            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Padding="6,3" Height="26" ClipToBounds="True" Background="{DynamicResource ErpStatusBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1"><infra:StatusMessageTextBlock Text="{Binding Status}" Opacity="0" IsHitTestVisible="False" /></Border>
    </Grid>
</UserControl>
