<UserControl
    x:Class="MiniERP.Desktop.Views.Customers.CustomerEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:infra="clr-namespace:MiniERP.Desktop.Infrastructure"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    Background="{DynamicResource ErpPageBrush}">

    <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="180,*">
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Background="{DynamicResource ErpSurfaceBrush}" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Save_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="✓" /><TextBlock Text="Save" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Discard_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="↶" /><TextBlock Text="Discard" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="×" /><TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Margin="5" Background="{DynamicResource ErpSurfaceBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1">
            <StackPanel Margin="4" Spacing="2">
                <Button HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="Address_Click" Content="Address" />
                <Button HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="Contact_Click" Content="Contact" />
                <TextBlock Margin="8,10,0,2" FontWeight="SemiBold" Opacity="0.65" Text="History" />
                <Button Margin="12,0,0,0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="QuoteHistory_Click" Content="Quote" />
                <Button Margin="12,0,0,0" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="OrderHistory_Click" Content="Order" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,5,5,5" Background="{DynamicResource ErpSurfaceBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer x:Name="AddressPanel" IsVisible="True">
                    <Grid Margin="30,20,30,20" HorizontalAlignment="Left" ColumnDefinitions="Auto,280" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <CheckBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Right" Content="Active" IsChecked="{Binding Customer.IsActive, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Name" /><TextBox Grid.Row="1" Grid.Column="1" Margin="0,2" Text="{Binding Customer.Name, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Address Line 1" /><TextBox Grid.Row="2" Grid.Column="1" Margin="0,2" Text="{Binding Customer.AddressLine1, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Address Line 2" /><TextBox Grid.Row="3" Grid.Column="1" Margin="0,2" Text="{Binding Customer.AddressLine2, Mode=TwoWay}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Country" />
                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="90,Auto" ColumnSpacing="5"><TextBox Grid.Column="0" Margin="0,2" IsReadOnly="True" Text="{Binding CountryCode, Mode=OneWay}" /><Button Grid.Column="1" Margin="0,2" Padding="8,2" Click="PickCountry_Click" Content="..." /></Grid>
                        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="Postal Code" /><TextBox Grid.Row="5" Grid.Column="1" Margin="0,2" Text="{Binding Customer.PostalCode, Mode=TwoWay}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="City" /><TextBox Grid.Row="6" Grid.Column="1" Margin="0,2" Text="{Binding Customer.City, Mode=TwoWay}" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Center" Text="State" /><TextBox Grid.Row="7" Grid.Column="1" Margin="0,2" Text="{Binding Customer.State, Mode=TwoWay}" />
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="ContactPanel" IsVisible="False" RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3" Spacing="3">
                        <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="NewContact_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="＋" /><TextBlock Text="New" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
                        <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="DeleteContact_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="×" /><TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
                    </StackPanel>

                    <dg:DataGrid Grid.Row="1" Margin="5" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="All" RowHeight="24" LoadingRow="SelectLineGrid_LoadingRow" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact, Mode=TwoWay}">
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Width="2*" Binding="{Binding Title, Mode=TwoWay}" Header="Title" />
                            <dg:DataGridTextColumn Width="4*" Binding="{Binding Name, Mode=TwoWay}" Header="Name" />
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>

                    <TextBlock Grid.Row="2" Margin="8,4" Opacity="0.6" Text="Contacts are saved together with the customer. Double-click a cell to edit it." />
                </Grid>

                <Grid x:Name="QuoteHistoryPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="6">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Quotation History" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Content="Refresh" Click="QuoteHistory_Click" />
                    </StackPanel>
                    <TextBlock x:Name="QuoteHistoryStatus" Grid.Row="1" Opacity="0.7" TextWrapping="Wrap" />
                    <dg:DataGrid x:Name="QuoteHistoryGrid" Grid.Row="2" AutoGenerateColumns="False"
                                 IsReadOnly="True" SelectionMode="Single" CanUserResizeColumns="True"
                                 CanUserSortColumns="True" GridLinesVisibility="All" RowHeight="24"
                                 Background="{DynamicResource ErpSurfaceBrush}"
                                 HorizontalGridLinesBrush="{DynamicResource ErpGridBrush}"
                                 VerticalGridLinesBrush="{DynamicResource ErpGridBrush}"
                                 LoadingRow="SelectLineGrid_LoadingRow" DoubleTapped="QuoteHistoryGrid_DoubleTapped">
                        <dg:DataGrid.Styles>
                            <Style Selector="DataGridRow.alternate"><Setter Property="Background" Value="{DynamicResource ErpAlternateBrush}" /></Style>
                            <Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="{DynamicResource ErpHoverBrush}" /></Style>
                            <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource ErpSelectedBrush}" /><Setter Property="TextBlock.Foreground" Value="{DynamicResource ErpSelectionTextBrush}" /></Style>
                        </dg:DataGrid.Styles>
                        <dg:DataGrid.Columns>
                            <dg:DataGridTextColumn Header="Quotation No." Width="1.6*" Binding="{Binding QuotationNumber}" />
                            <dg:DataGridTextColumn Header="Date" Width="*" Binding="{Binding QuotationDate, StringFormat='{}{0:yyyy-MM-dd}'}" />
                            <dg:DataGridTextColumn Header="User" Width="1.2*" Binding="{Binding User.Name}" />
                            <dg:DataGridTextColumn Header="Currency" Width="0.7*" Binding="{Binding Currency}" />
                            <dg:DataGridTextColumn Header="Total" Width="*" Binding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" />
                            <dg:DataGridTextColumn Header="Valid Until" Width="*" Binding="{Binding ValidUntil, StringFormat='{}{0:yyyy-MM-dd}'}" />
                            <dg:DataGridTextColumn Header="Delivery Term" Width="1.2*" Binding="{Binding DeliveryTerm}" />
                            <dg:DataGridTextColumn Header="Lead Time" Width="1.2*" Binding="{Binding LeadTime}" />
                            <dg:DataGridTextColumn Header="Payment Term" Width="1.4*" Binding="{Binding PaymentTerm}" />
                        </dg:DataGrid.Columns>
                    </dg:DataGrid>
                </Grid>

                <StackPanel x:Name="HistoryPanel" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <TextBlock x:Name="HistoryTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Text="History" />
                    <TextBlock Opacity="0.55" Text="This history view will be connected when the document modules are migrated." />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Padding="6,3" Height="26" ClipToBounds="True" Background="{DynamicResource ErpStatusBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1"><infra:StatusMessageTextBlock Text="{Binding Status}" Opacity="0" IsHitTestVisible="False" /></Border>
    </Grid>
</UserControl>
