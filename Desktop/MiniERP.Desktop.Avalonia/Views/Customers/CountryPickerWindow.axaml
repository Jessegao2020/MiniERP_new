<Window
    x:Class="MiniERP.Desktop.Views.Customers.CountryPickerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    Title="Country" Width="420" Height="360" CanResize="False" WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Border.grid-header"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#C9C9C9" /><Setter Property="BorderThickness" Value="0,0,1,1" /></Style>
        <Style Selector="Border.grid-header:pointerover"><Setter Property="Background" Value="#F3F3F3" /></Style>
        <Style Selector="TextBox.grid-filter"><Setter Property="Height" Value="22" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="5,0,4,0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Background" Value="#FFFEEF" /><Setter Property="BorderBrush" Value="#DDDCCB" /><Setter Property="BorderThickness" Value="0,0,1,1" /><Setter Property="FontSize" Value="11" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto" Margin="10">
        <Grid x:Name="CountryTableLayout" Grid.Row="0" RowDefinitions="24,22,*" SizeChanged="TableLayout_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="80" MinWidth="60" /><ColumnDefinition Width="*" MinWidth="160" /></Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#C9C9C9" BorderThickness="1,1,0,0" IsHitTestVisible="False" />
            <Border Grid.Row="0" Grid.Column="0" Classes="grid-header" Tag="Code" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Code" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="CodeSortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="0" Grid.Column="1" Classes="grid-header" Tag="Name" Tapped="SortHeader_Tapped"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Country" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="NameSortArrow" Grid.Column="1" FontSize="8" /></Grid></Border>
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FFFEEF" BorderBrush="#DDDCCB" BorderThickness="1,0,0,0" IsHitTestVisible="False" />
            <TextBox x:Name="CodeFilterTextBox" Grid.Row="1" Grid.Column="0" Classes="grid-filter" TextChanged="Filter_TextChanged" /><TextBox x:Name="NameFilterTextBox" Grid.Row="1" Grid.Column="1" Classes="grid-filter" TextChanged="Filter_TextChanged" />
            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="5" HorizontalAlignment="Right" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="CurrentAndNext" DragDelta="ColumnSplitter_DragDelta" />
            <dg:DataGrid x:Name="CountryGrid" Grid.Row="2" Grid.ColumnSpan="2" AutoGenerateColumns="False" Background="White" BorderBrush="#D4D4D4" BorderThickness="1,0,1,1" CanUserResizeColumns="False" CanUserSortColumns="False" FontSize="12" GridLinesVisibility="All" HeadersVisibility="None" HorizontalGridLinesBrush="#E4E4E4" VerticalGridLinesBrush="#E4E4E4" RowHeight="24" IsReadOnly="True" SelectionMode="Single" LoadingRow="Grid_LoadingRow" DoubleTapped="CountryGrid_DoubleTapped">
                <dg:DataGrid.Styles><Style Selector="DataGridCell"><Setter Property="Padding" Value="5,2" /></Style><Style Selector="DataGridRow.alternate"><Setter Property="Background" Value="#F3F3F3" /></Style><Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="#EAF2F8" /></Style><Style Selector="DataGridRow:selected"><Setter Property="Background" Value="#3394D6" /><Setter Property="TextBlock.Foreground" Value="#111111" /></Style></dg:DataGrid.Styles>
                <dg:DataGrid.Columns><dg:DataGridTextColumn Width="80" Binding="{Binding Code}" /><dg:DataGridTextColumn Width="*" Binding="{Binding Name}" /></dg:DataGrid.Columns>
            </dg:DataGrid>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Width="90" Click="Ok_Click" Content="OK" /><Button Width="90" Click="Cancel_Click" Content="Cancel" /></StackPanel>
    </Grid>
</Window>