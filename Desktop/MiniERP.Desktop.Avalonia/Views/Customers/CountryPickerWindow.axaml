<Window
    x:Class="MiniERP.Desktop.Views.Customers.CountryPickerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
    Title="Country / Region" Width="420" Height="360" CanResize="False" WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Border.grid-header"><Setter Property="Background" Value="{DynamicResource ErpSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ErpBorderBrush}" /><Setter Property="BorderThickness" Value="0,0,1,1" /></Style>
        <Style Selector="Border.grid-header:pointerover"><Setter Property="Background" Value="{DynamicResource ErpAlternateBrush}" /></Style>
        <Style Selector="TextBox.grid-filter"><Setter Property="Height" Value="22" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="5,0,4,0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Background" Value="{DynamicResource ErpFilterBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ErpSpecialBrush}" /><Setter Property="BorderThickness" Value="0,0,1,1" /><Setter Property="FontSize" Value="11" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto" Margin="10">
        <dg:DataGrid x:Name="CountryGrid" Grid.Row="0" AutoGenerateColumns="False" Background="{DynamicResource ErpSurfaceBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1" CanUserResizeColumns="True" CanUserReorderColumns="False" CanUserSortColumns="True" Sorting="Grid_Sorting" FontSize="12" GridLinesVisibility="All" HeadersVisibility="Column" ColumnHeaderHeight="46" ColumnHeaderTheme="{StaticResource SelectLineFilterColumnHeader}" Classes="selectline-filter-grid" HorizontalGridLinesBrush="{DynamicResource ErpGridBrush}" VerticalGridLinesBrush="{DynamicResource ErpGridBrush}" RowHeight="24" IsReadOnly="True" SelectionMode="Single" LoadingRow="Grid_LoadingRow" DoubleTapped="CountryGrid_DoubleTapped">
                <dg:DataGrid.Styles><Style Selector="DataGridCell"><Setter Property="Padding" Value="5,2" /></Style><Style Selector="DataGridRow.alternate"><Setter Property="Background" Value="{DynamicResource ErpAlternateBrush}" /></Style><Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="{DynamicResource ErpHoverBrush}" /></Style><Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource ErpSelectedBrush}" /><Setter Property="TextBlock.Foreground" Value="{DynamicResource ErpSelectionTextBrush}" /></Style></dg:DataGrid.Styles>
                <dg:DataGrid.Columns><dg:DataGridTextColumn Width="80" Binding="{Binding Code}" MinWidth="60">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="Code"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Code" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Tag="Code" Grid.Row="1" Classes="grid-filter" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn><dg:DataGridTextColumn Width="*" Binding="{Binding Name}" MinWidth="160">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="Name"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Country / Region" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" /></Grid></Border>
                                <TextBox Tag="Name" Grid.Row="1" Classes="grid-filter" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn></dg:DataGrid.Columns>
            </dg:DataGrid>
        <StackPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button Width="90" Click="Ok_Click" Content="OK" /><Button Width="90" Click="Cancel_Click" Content="Cancel" /></StackPanel>
    </Grid>
</Window>