<UserControl
    x:Class="MiniERP.Desktop.Views.Customers.CustomerListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3,0,0,0" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="New_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="＋" />
                    <TextBlock Text="New" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="⧉" />
                    <TextBlock Text="Duplicate" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="×" />
                    <TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Border Width="1" Margin="5,3" Background="#D0D0D0" />
            <Button Padding="8,2" Click="Refresh_Click" Content="Refresh" />
        </StackPanel>

        <dg:DataGrid
            x:Name="CustomerGrid"
            Grid.Row="1"
            Margin="0,5,0,0"
            AutoGenerateColumns="False"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            GridLinesVisibility="All"
            IsReadOnly="True"
            ItemsSource="{Binding Customers}"
            SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
            DoubleTapped="CustomerGrid_DoubleTapped">

            <dg:DataGrid.Columns>
                <dg:DataGridTextColumn Width="3*" Binding="{Binding Name}">
                    <dg:DataGridTextColumn.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Name" />
                            <TextBox MinWidth="90" Height="24" Tag="Name" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </StackPanel>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="2*" Binding="{Binding AddressLine1}">
                    <dg:DataGridTextColumn.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Address" />
                            <TextBox MinWidth="80" Height="24" Tag="AddressLine1" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </StackPanel>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="*" Binding="{Binding City}">
                    <dg:DataGridTextColumn.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="City" />
                            <TextBox MinWidth="65" Height="24" Tag="City" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </StackPanel>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="*" Binding="{Binding State}">
                    <dg:DataGridTextColumn.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="State" />
                            <TextBox MinWidth="65" Height="24" Tag="State" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </StackPanel>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="*" Binding="{Binding PostalCode}">
                    <dg:DataGridTextColumn.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Postal" />
                            <TextBox MinWidth="65" Height="24" Tag="PostalCode" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </StackPanel>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>

                <dg:DataGridTextColumn Width="*" Binding="{Binding Country}">
                    <dg:DataGridTextColumn.Header>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Country" />
                            <TextBox MinWidth="65" Height="24" Tag="Country" Watermark="Filter" TextChanged="Filter_TextChanged" />
                        </StackPanel>
                    </dg:DataGridTextColumn.Header>
                </dg:DataGridTextColumn>
            </dg:DataGrid.Columns>
        </dg:DataGrid>

        <Border Grid.Row="2" Padding="6,3" Background="#E8E8E8" BorderBrush="LightGray" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Foreground="#CB004A" Text="{Binding Status}" />
                <TextBlock Grid.Column="1" Foreground="#CB004A" Text="Double-click a row to edit" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
