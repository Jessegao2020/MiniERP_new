<UserControl
    x:Class="MiniERP.Desktop.Views.Customers.CustomerListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:infra="clr-namespace:MiniERP.Desktop.Infrastructure"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">

    <UserControl.Styles>
        <Style Selector="Border.grid-header">
            <Setter Property="Background" Value="{DynamicResource ErpSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErpBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style Selector="Border.grid-header:pointerover">
            <Setter Property="Background" Value="{DynamicResource ErpAlternateBrush}" />
        </Style>
        <Style Selector="TextBox.grid-filter">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="5,0,4,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ErpFilterBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErpSpecialBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3,0,0,0" Spacing="3">
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="New_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="＋" /><TextBlock Text="New" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="⧉" /><TextBlock Text="Duplicate" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Delete_Click"><StackPanel Orientation="Horizontal" Spacing="4"><TextBlock Text="×" /><TextBlock Text="Delete" FontSize="10" VerticalAlignment="Center" /></StackPanel></Button>
            <Border Width="1" Margin="5,3" Background="{DynamicResource ErpBorderBrush}" />
            <Button Padding="6,2" Background="Transparent" BorderThickness="0" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="↻" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="Refresh" FontSize="10" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <dg:DataGrid x:Name="CustomerGrid" Grid.Row="1" Margin="0,4,0,0" AutoGenerateColumns="False" Background="{DynamicResource ErpSurfaceBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1" CanUserResizeColumns="True" CanUserReorderColumns="False" CanUserSortColumns="True" Sorting="Grid_Sorting" FontSize="12" GridLinesVisibility="All" HeadersVisibility="Column" ColumnHeaderHeight="46" ColumnHeaderTheme="{StaticResource SelectLineFilterColumnHeader}" Classes="selectline-filter-grid" HorizontalGridLinesBrush="{DynamicResource ErpGridBrush}" VerticalGridLinesBrush="{DynamicResource ErpGridBrush}" RowBackground="{DynamicResource ErpSurfaceBrush}" RowHeight="24" IsReadOnly="True" SelectionMode="Single" LoadingRow="Grid_LoadingRow" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" DoubleTapped="CustomerGrid_DoubleTapped">
                <dg:DataGrid.Styles>
                    <Style Selector="DataGridCell"><Setter Property="Padding" Value="5,2" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
                    <Style Selector="DataGridRow.alternate"><Setter Property="Background" Value="{DynamicResource ErpAlternateBrush}" /></Style>
                    <Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="{DynamicResource ErpHoverBrush}" /></Style>
                    <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource ErpSelectedBrush}" /><Setter Property="TextBlock.Foreground" Value="{DynamicResource ErpSelectionTextBrush}" /></Style>
                </dg:DataGrid.Styles>
                <dg:DataGrid.Columns>
                    <dg:DataGridTextColumn Width="3*" Binding="{Binding Name}" MinWidth="90">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="Name"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Name" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" VerticalAlignment="Center" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Name" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn>
                    <dg:DataGridTextColumn Width="2*" Binding="{Binding AddressLine1}" MinWidth="80">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="AddressLine1"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Address" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" VerticalAlignment="Center" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="AddressLine1" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn>
                    <dg:DataGridTextColumn Width="*" Binding="{Binding City}" MinWidth="65">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="City"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="City" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" VerticalAlignment="Center" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="City" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn>
                    <dg:DataGridTextColumn Width="*" Binding="{Binding State}" MinWidth="65">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="State"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="State" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" VerticalAlignment="Center" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="State" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn>
                    <dg:DataGridTextColumn Width="*" Binding="{Binding PostalCode}" MinWidth="65">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="PostalCode"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Postal" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" VerticalAlignment="Center" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="PostalCode" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn>
                    <dg:DataGridTextColumn Width="*" Binding="{Binding Country}" MinWidth="65">
                        <dg:DataGridTextColumn.Header>
                            <Grid RowDefinitions="24,22" ClipToBounds="True">
                                <Border Classes="grid-header" Tag="Country"><Grid Margin="5,0" ColumnDefinitions="*,Auto"><TextBlock Text="Country" FontSize="11" VerticalAlignment="Center" /><TextBlock Classes="grid-sort-arrow" Grid.Column="1" FontSize="8" VerticalAlignment="Center" /></Grid></Border>
                                <TextBox Grid.Row="1" Classes="grid-filter" Tag="Country" TextChanged="Filter_TextChanged" />
                            </Grid>
                        </dg:DataGridTextColumn.Header>
                    </dg:DataGridTextColumn>
                </dg:DataGrid.Columns>
            </dg:DataGrid>

        <Border Grid.Row="2" Padding="6,3" Height="26" ClipToBounds="True" Background="{DynamicResource ErpStatusBrush}" BorderBrush="{DynamicResource ErpBorderBrush}" BorderThickness="1"><Grid ColumnDefinitions="*,Auto"><infra:StatusMessageTextBlock Text="{Binding Status}" Opacity="0" IsHitTestVisible="False" /><TextBlock Grid.Column="1" Foreground="{DynamicResource ErpFooterAccentBrush}" Text="Double-click a row to edit" /></Grid></Border>
    </Grid>
</UserControl>
