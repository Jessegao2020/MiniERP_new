<Window
    x:Class="MiniERP.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MiniERP"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600">

    <Window.Styles>
        <Style Selector="Button.ribbon">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="2,2,3,2" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.ribbonIcon">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.ribbonText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Top Menu Bar -->
        <Menu Grid.Row="0" Padding="2">
            <MenuItem Header="File" />
            <MenuItem Header="Edit" />
            <MenuItem Header="About" />
        </Menu>

        <!-- Ribbon-like main navigation, matching the original WPF layout -->
        <TabControl
            x:Name="MenuTabControl"
            Grid.Row="1"
            BorderThickness="1,1,1,0">

            <TabItem Header="General" Padding="10,5">
                <Border Height="66" Padding="2,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="ribbon" Click="Article_Click" ToolTip.Tip="Articles">
                            <StackPanel>
                                <TextBlock Classes="ribbonIcon" Text="▤" />
                                <TextBlock Classes="ribbonText" Text="Article" />
                            </StackPanel>
                        </Button>

                        <Button Classes="ribbon" Click="Customer_Click" ToolTip.Tip="Customers">
                            <StackPanel>
                                <TextBlock Classes="ribbonIcon" Text="♙" />
                                <TextBlock Classes="ribbonText" Text="Customer" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Documents" Padding="10,5">
                <Border Height="66" Padding="2,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="ribbon" Click="Quotation_Click" ToolTip.Tip="Quotation">
                            <StackPanel>
                                <TextBlock Classes="ribbonIcon" Text="≣" />
                                <TextBlock Classes="ribbonText" Text="Quote" />
                            </StackPanel>
                        </Button>

                        <Button Classes="ribbon" Click="Order_Click" ToolTip.Tip="Order">
                            <StackPanel>
                                <TextBlock Classes="ribbonIcon" Text="☷" />
                                <TextBlock Classes="ribbonText" Text="Order" />
                            </StackPanel>
                        </Button>

                        <Button Classes="ribbon" Click="Invoice_Click" ToolTip.Tip="Invoice">
                            <StackPanel>
                                <TextBlock Classes="ribbonIcon" Text="¤" />
                                <TextBlock Classes="ribbonText" Text="Invoice" />
                            </StackPanel>
                        </Button>

                        <Button Classes="ribbon" Click="PackingList_Click" ToolTip.Tip="Packing List">
                            <StackPanel>
                                <TextBlock Classes="ribbonIcon" Text="▦" />
                                <TextBlock Classes="ribbonText" Text="P/L" />
                            </StackPanel>
                        </Button>

                        <Button Classes="ribbon" Click="ProformaInvoice_Click" ToolTip.Tip="Proforma Invoice">
                            <StackPanel>
                                <TextBlock Classes="ribbonIcon" Text="PI" FontSize="18" Margin="0,5,0,2" />
                                <TextBlock Classes="ribbonText" Text="P/I" />
                            </StackPanel>
                        </Button>

                        <Button Classes="ribbon" Click="Contract_Click" ToolTip.Tip="Contract">
                            <StackPanel>
                                <TextBlock Classes="ribbonIcon" Text="§" />
                                <TextBlock Classes="ribbonText" Text="Contract" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="Settings" Padding="10,5">
                <Border Height="66" Padding="2,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="ribbon" Click="System_Click">
                            <StackPanel>
                                <TextBlock Classes="ribbonIcon" Text="⚙" />
                                <TextBlock Classes="ribbonText" Text="System" />
                            </StackPanel>
                        </Button>

                        <Button Classes="ribbon" Click="User_Click">
                            <StackPanel>
                                <TextBlock Classes="ribbonIcon" Text="♙" />
                                <TextBlock Classes="ribbonText" Text="User" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Workspace tabs -->
        <Border Grid.Row="2" BorderThickness="1,0,1,1">
            <TabControl
                x:Name="ContentTabControl"
                BorderThickness="0"
                Padding="0" />
        </Border>

    </Grid>
</Window>
