<Window
    x:Class="MiniERP.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:MiniERP.Desktop.Views"
    Title="MiniERP"
    Icon="/Assets/app.png"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="600"
    Background="{DynamicResource ErpPageBrush}">

    <Window.Styles>
        <Style Selector="Button.ribbon">
            <Setter Property="Width" Value="62" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Margin" Value="2,2,3,2" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.ribbonIcon"><Setter Property="FontSize" Value="25" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style Selector="Image.ribbonIcon"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
        <Style Selector="TextBlock.ribbonText"><Setter Property="FontSize" Value="12" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <Menu Grid.Row="0" Classes="erp-main-menu" Padding="2">
            <MenuItem Header="File" />
            <MenuItem Header="Edit" />
            <MenuItem Header="View">
                <MenuItem Header="Appearance">
                    <MenuItem Header="Follow system" Click="ThemeSystem_Click" />
                    <MenuItem Header="Light" Click="ThemeLight_Click" />
                    <MenuItem Header="Dark" Click="ThemeDark_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="About" />
        </Menu>
        <TabControl x:Name="MenuTabControl" Classes="erp-ribbon" Grid.Row="1" BorderThickness="1,1,1,0">
            <TabItem Header="General" Padding="10,5">
                <Border Height="66" Padding="2,1"><StackPanel Orientation="Horizontal">
                    <Button Classes="ribbon" Click="Article_Click" ToolTip.Tip="Articles"><StackPanel><Image Classes="ribbonIcon" Source="/Assets/article.png" /><TextBlock Classes="ribbonText" Text="Article" /></StackPanel></Button>
                    <Button Classes="ribbon" Click="Customer_Click" ToolTip.Tip="Customers"><StackPanel><Image Classes="ribbonIcon" Source="/Assets/customer.png" /><TextBlock Classes="ribbonText" Text="Customer" /></StackPanel></Button>
                </StackPanel></Border>
            </TabItem>

            <TabItem Header="Documents" Padding="10,5">
                <Border Height="66" Padding="2,1"><StackPanel Orientation="Horizontal">
                    <Button Classes="ribbon" Click="Quotation_Click" ToolTip.Tip="Quotation"><StackPanel><Image Classes="ribbonIcon" Source="/Assets/quotation.png" /><TextBlock Classes="ribbonText" Text="Quote" /></StackPanel></Button>
                    <Button Classes="ribbon" Click="ProformaInvoice_Click" ToolTip.Tip="Proforma Invoice"><StackPanel><Image Classes="ribbonIcon" Source="/Assets/order.png" /><TextBlock Classes="ribbonText" Text="P/I" /></StackPanel></Button>
                    <Button Classes="ribbon" Click="Invoice_Click" ToolTip.Tip="Commercial Invoice"><StackPanel><Image Classes="ribbonIcon" Source="/Assets/invoice.png" /><TextBlock Classes="ribbonText" Text="Invoice" /></StackPanel></Button>
                    <Button Classes="ribbon" Click="PackingList_Click" ToolTip.Tip="Packing List"><StackPanel><Image Classes="ribbonIcon" Source="/Assets/packing-list.png" /><TextBlock Classes="ribbonText" Text="P/L" /></StackPanel></Button>
                    <Button Classes="ribbon" Click="Contract_Click" ToolTip.Tip="Contract"><StackPanel><TextBlock Classes="ribbonIcon" Text="§" /><TextBlock Classes="ribbonText" Text="Contract" /></StackPanel></Button>
                </StackPanel></Border>
            </TabItem>

            <TabItem Header="Settings" Padding="10,5">
                <Border Height="66" Padding="2,1"><StackPanel Orientation="Horizontal">
                    <Button Classes="ribbon" Click="System_Click"><StackPanel><TextBlock Classes="ribbonIcon" Text="⚙" /><TextBlock Classes="ribbonText" Text="System" /></StackPanel></Button>
                    <Button Classes="ribbon" Click="User_Click"><StackPanel><TextBlock Classes="ribbonIcon" Text="♙" /><TextBlock Classes="ribbonText" Text="User" /></StackPanel></Button>
                </StackPanel></Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderThickness="1,0,1,1" Background="{DynamicResource ErpSurfaceBrush}">
            <local:WorkspaceTabHost x:Name="ContentTabControl" />
        </Border>
    </Grid>
</Window>
